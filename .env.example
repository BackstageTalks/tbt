# Existing GitHub/Azure secrets
RAPIDAPI_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
TGBOT=
TGCHID=

# Strongly recommended for production server-side writes.
# Never expose this key in web/config.js or VITE variables.
SUPABASE_SERVICE_ROLE_KEY=

# Protects admin refresh endpoints.
TBT_ADMIN_API_KEY=

# Current RapidAPI product documented by Tennis API.
RAPIDAPI_HOST=tennis-api-atp-wta-itf.p.rapidapi.com
RAPIDAPI_BASE_URL=https://tennis-api-atp-wta-itf.p.rapidapi.com

# Optional tuning
TBT_MODEL_ARTIFACT=api/artifacts/model.joblib
TBT_HISTORY_START_YEAR=2018
TBT_PREDICTION_HORIZON_DAYS=3
TBT_MIN_TRAIN_MATCHES=2500
TBT_ALLOW_ANON_WRITES=false
TBT_LOG_LEVEL=INFO
TBT_CORS_ORIGINS=*
