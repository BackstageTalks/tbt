{
  "routes": [
    {
      "route": "/",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "route": "/release.json",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "route": "/blinq-app.css",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/auth.js",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/app.js",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/responsive.js",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/ui-config.json",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/match-popout.js",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/follow-the-data",
      "rewrite": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "route": "/auth/action",
      "rewrite": "/auth/action/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      }
    },
    {
      "route": "/deployment.json",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/config/*",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/membership-links.json",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/*.css",
      "/*.js",
      "/*.webmanifest",
      "/assets/*"
    ]
  },
  "platform": {
    "apiRuntime": "python:3.11"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://identitytoolkit.googleapis.com https://securetoken.googleapis.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-src 'none'; manifest-src 'self'; upgrade-insecure-requests",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-origin"
  },
  "routeRules": [
    {
      "route": "/mobile-preview.css",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/mobile-preview-overlays.css",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/mobile-preview-results.css",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/mobile-preview-daily.css",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/mobile-preview-base.css",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    },
    {
      "route": "/mobile-preview.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      }
    }
  ]
}
