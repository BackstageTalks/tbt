/* BlinQ responsive UI. Central layout rules for all devices.
   Keep --cards-per-panel aligned with the dashboard grid; app.js reads it. */
:root {
  --cards-per-panel: 1;
  --sidebar-width: 208px;
  --control-size: 44px;
  --muted: #a4b2c5;
  --line: #243449;
  font-size: 16px;
}
html {scroll-padding-top: 110px; -webkit-text-size-adjust: 100%;}
body {font-size: 14px; line-height: 1.5;}
button, a, input, select, summary { -webkit-tap-highlight-color: transparent; }
button, a, summary {touch-action: manipulation;}
button, input, select, textarea {max-width: 100%;}
input, select, textarea {min-width: 0; font-size: 16px;}
button:disabled {cursor: default; opacity: .45;}
:focus-visible {outline: 2px solid #ba9bff; outline-offset: 4px;}
h1:focus, main:focus {outline: none;}
[hidden] {display: none !important;}
.skip-link {position: fixed; left: 12px; top: -90px; z-index: 100; padding: 12px 18px; background: #7047ff; color: white; border-radius: 8px;}
.skip-link:focus {top: 12px;}
.no-script {padding: 30px; max-width: 680px; margin: auto;}
.dashboard-shell {display: block; min-height: 100dvh;}
.dashboard-main {width: 100%; max-width: 1840px; margin: 0 auto; padding: 0 16px calc(92px + env(safe-area-inset-bottom));}
.dashboard-sidebar {position: fixed; inset: 0 auto 0 0; width: min(300px,calc(100vw - 48px)); height: 100dvh; padding: 24px 16px; overflow-y: auto; overscroll-behavior: contain; z-index: 61; transform: translateX(-102%); visibility: hidden; transition: transform .2s ease,visibility .2s; background: #080f1a; border-right: 1px solid #27344a;}
.nav-open {overflow: hidden;}
.nav-open .dashboard-sidebar {transform: translateX(0); visibility: visible;}
.nav-backdrop {position: fixed; inset: 0; z-index: 60; border: 0; border-radius: 0; background: #0009; width: 100%; height: 100%;}
.mobile-menu-close {position: absolute; top: 16px; right: 10px; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 10px; background: #101a29; color: white; font-size: 24px; cursor: pointer;}
.dashboard-sidebar .engine-brand {height: auto; min-height: 76px; padding: 0 0 16px; display: grid; justify-content: start; justify-items: start; border: 0;}
.engine-brand .brand-logo {width: 120px; max-height: none;}
.engine-copy {display: none;}
.dashboard-sidebar .nav-section {margin-top: 8px;}
.dashboard-sidebar .nav-items {display: grid; gap: 5px; overflow: visible;}
.dashboard-sidebar .nav-link {min-height: 46px; padding: 10px 12px; border: 1px solid transparent; font-size: 14px; line-height: 1.35;}
.dashboard-sidebar .nav-link.active {border-color: #6246bd; background: linear-gradient(100deg,#322166,#18152d);}
.nav-link .nav-icon {font-size: 17px; flex: 0 0 22px;}
.nav-link .beta-tag {font-size: 10px; padding: 2px 4px;}
.sidebar-promo-zone {display: none !important;}
.sidebar-spacer {display: block; min-height: 20px;}
.nav-admin {margin-top: auto !important;}
.dashboard-topbar, .dashboard-topbar.overview-mode {position: sticky; top: 0; z-index: 20; display: flex; align-items: center; gap: 12px; min-height: 80px; height: auto; padding: 12px 0; border-bottom: 1px solid #243449; background: #050912f5; backdrop-filter: blur(16px);}
.mobile-menu-button {display: grid; place-items: center; flex: 0 0 44px; width: 44px; height: 44px; border: 1px solid #30425c; border-radius: 11px; background: #0d1725; color: #d9e2f0; font-size: 22px; cursor: pointer;}
.route-context-meta {display: grid; flex: 1; min-width: 0; gap: 2px;}
#pageEyebrow {font-size: 10px; font-weight: 800; letter-spacing: .12em; color: #ad99e5;}
#pageTitle {margin: 0; font-size: clamp(19px,2vw,26px); line-height: 1.2; letter-spacing: -.03em; overflow-wrap: anywhere;}
#pageSubtitle {display: none;}
.header-feature-strip, .dashboard-live-chip, .topbar-balance {display: none !important;}
.dashboard-account-actions {display: flex; flex: 0 0 auto; width: auto; gap: 10px; margin: 0 0 0 auto; flex-wrap: nowrap;}
.dashboard-account-actions .top-upgrade {display: none; width: auto; height: 44px; min-height: 44px; font-size: 13px; padding: 8px 16px;}
.profile-shell {display: grid; width: auto; min-height: 44px; height: auto; grid-template-columns: minmax(0,1fr) 36px; padding: 2px; gap: 2px; border-radius: 12px;}
.profile-button-large {width: auto; min-width: 0; padding: 2px; gap: 10px; border: 0; background: none; box-shadow: none; border-radius: 10px;}
.profile-button-large .profile-copy {display: none; min-width: 0;}
.avatar-large {width: 36px; height: 36px; flex-basis: 36px;}
.profile-menu-toggle {width: 36px; height: 44px; min-height: 44px; font-size: 18px;}
.profile-menu {right: 0; width: min(300px,calc(100vw - 32px)); padding: 8px;}
.profile-menu button {min-height: 52px; padding: 10px;}
.profile-menu button strong {font-size: 14px;}
.profile-menu button small {font-size: 12px; color: #a4b2c5;}
.account-hover-tooltip, .dashboard-datetime {display: none !important;}
.sync-bar {display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 0 14px; min-height: 58px;}
.sync-state {display: flex; align-items: center; gap: 8px; color: #a4b2c5; font-size: 12px;}
.sync-state::before {content: ''; width: 6px; height: 6px; flex: 0 0 6px; background: #6be56a; border-radius: 50%;}
.sync-state[data-state="loading"]::before {background: #aa89ff;}
.sync-state:is([data-state="offline"],[data-state="error"],[data-state="stale"])::before {background: #f1c65c;}
.sync-refresh {min-height: 44px; white-space: nowrap; border: 0; padding: 6px 4px 6px 10px; background: none; color: #c4afff; font-size: 13px; cursor: pointer;}
.inline-notice {margin: 0 0 16px; font-size: 13px;}
.status-banner {max-width: calc(100vw - 32px); width: max-content; font-size: 14px; top: 12px;}
.mobile-tabs {position: fixed; z-index: 30; inset: auto 0 0; display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); border-top: 1px solid #2b3550; padding: 5px max(12px,env(safe-area-inset-right)) calc(5px + env(safe-area-inset-bottom)) max(12px,env(safe-area-inset-left)); background: #090f1bf5; backdrop-filter: blur(16px);}
.mobile-tabs a {display: grid; justify-items: center; gap: 1px; padding: 5px; text-decoration: none; color: #a1aec1; font-size: 12px; min-height: 52px; border-radius: 10px;}
.mobile-tabs a>span {font-size: 21px; line-height: 1.1;}
.mobile-tabs a.active {color: #c9b5ff; background: #251c45;}
#predictionsView {display: grid; grid-template-columns: minmax(0,1fr); gap: 18px; align-items: start; padding-bottom: 4px;}
#predictionsView[hidden] {display: none;}
#predictionsView>.picks-panel {min-height: 0; padding: 16px; border-radius: 16px; margin: 0; background: linear-gradient(150deg,#0c1522,#080f19); box-shadow: none;}
.picks-head {align-items: center; gap: 12px; margin: 0 0 16px; flex-wrap: wrap;}
.section-kicker {font-size: 17px; line-height: 1.3; letter-spacing: -.02em;}
.section-kicker span {margin-right: 4px;}
.section-count, .match-count {font-size: 12px; color: #a4b2c5;}
.panel-actions, .section-actions {gap: 8px;}
#predictionsView .pick-carousel, #predictionsView .market-preview-grid {display: grid; grid-template-columns: repeat(var(--visible-cards,var(--cards-per-panel)),minmax(0,1fr)); gap: 12px;}
#predictionsView .prediction-card:nth-child(n) {display: flex !important; flex-direction: column; min-width: 0; min-height: 0; height: auto; padding: 16px; border-radius: 12px; border-color: #2a3a50; background: linear-gradient(155deg,#0f1c2b,#09121c);}
#predictionsView .prediction-card.featured {border-color: #4d3b87;}
.prediction-card .card-meta {display: flex; gap: 7px; align-items: flex-start; font-size: 11px; min-height: 24px; color: #adbbce;}
.prediction-card .card-meta .tour {white-space: normal; line-height: 1.4; overflow-wrap: anywhere;}
.prediction-card .card-meta .surface {font-size: 10px; padding: 2px 5px; max-width: 70px; overflow-wrap: anywhere;}
.prediction-card .card-meta .time {font-size: 11px; padding-top: 1px;}
.prediction-card .players-row {grid-template-columns: minmax(0,1fr) 24px minmax(0,1fr); margin: 16px 0; gap: 6px; align-items: start;}
.prediction-card .player-avatar {width: 52px; height: 52px; font-size: 18px;}
.prediction-card .player-name {white-space: normal; overflow-wrap: anywhere; font-size: 14px; line-height: 1.35; margin-top: 10px; text-align: center;}
.prediction-card .player-rank {font-size: 11px; color: #9eafc4; margin-top: 4px;}
.prediction-card .vs {font-size: 11px; align-self: center; color: #94a5bb;}
.prediction-card .pick-row {display: grid; grid-template-columns: minmax(0,1fr) auto; align-items: center; gap: 4px 12px; padding: 13px 0; border-color: #28384b;}
.prediction-card .pick-row>div:first-child {grid-row: 1 / 3;}
.prediction-card .pick-row small {font-size: 11px; color: #a4b3c7; margin-bottom: 4px;}
.prediction-card .pick-name {font-size: 16px; white-space: normal; overflow-wrap: anywhere; line-height: 1.3;}
.prediction-card .probability {font-size: 25px; line-height: 1.15; text-align: right; letter-spacing: -.04em;}
.prediction-card .confidence {grid-column: 2; justify-self: end; font-size: 9px; padding: 4px 6px; line-height: 1.1; letter-spacing: .02em;}
.prediction-card .data-depth-row, .prediction-card .market-card-meta {font-size: 12px; color: #a4b3c7; line-height: 1.6; overflow-wrap: anywhere;}
.prediction-card .market-card-meta {padding-top: 12px;}
.prediction-card .betting-row {display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 5px 12px; padding: 12px 0 6px; font-size: 12px; line-height: 1.5; white-space: normal;}
.prediction-card .signals {min-height: 0; padding: 12px 0 0; gap: 9px;}
.prediction-card .signal-row {font-size: 12px; color: #bcc7d6; grid-template-columns: minmax(0,1fr) 64px;}
.prediction-card .analysis-link {min-height: 44px; margin-top: 8px; font-size: 13px; color: #b89aff;}
.pick-carousel-shell, .market-carousel-shell {position: relative; touch-action: pan-y;}
.pick-carousel-shell.has-pages, .market-carousel-shell.has-pages {padding-bottom: 56px;}
#predictionsView .carousel-arrow, #predictionsView .market-arrow {display: grid; place-items: center; position: absolute; top: auto; bottom: 0; transform: none; width: 44px; height: 44px; border: 1px solid #354762; border-radius: 10px; background: #101d2d; color: #c8b8ff; box-shadow: none; font-size: 24px; z-index: 2;}
#predictionsView .carousel-arrow-left, #predictionsView .market-arrow.prev {left: 0;}
#predictionsView .carousel-arrow-right, #predictionsView .market-arrow.next {right: 0;}
.page-position {position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%); font-size: 13px; color: #9cabc0; font-variant-numeric: tabular-nums;}
.carousel-dots {display: none;}
#predictionsView .section-see-all-card {display: flex; flex-wrap: wrap; align-items: center; gap: 8px; min-height: 48px; padding: 12px 2px 0; border: 0; border-top: 1px solid #233145; border-radius: 0; background: none; margin-top: 16px;}
#predictionsView .section-see-all-card span {display: none;}
#predictionsView .section-see-all-card strong {display: block; font-size: 12px; color: #9cabc0; font-weight: 500;}
#predictionsView .section-see-all-card b {margin-left: auto; font-size: 13px; color: #c7b1ff;}
.state-card {padding: 28px 20px; font-size: 14px; color: #a7b6ca; line-height: 1.7;}
.dashboard-locked-card {position: relative; min-height: 240px !important; justify-content: center;}
.locked-pick-copy strong {font-size: 16px;}
.locked-pick-copy small, .locked-pick-copy span {font-size: 12px;}
#bannerTop, #bannerMid, #bannerBottom {display: grid; grid-template-columns: minmax(0,1fr); grid-column: 1 / -1; margin: 0; gap: 0;}
#predictionsView .promo-grid .promo-card {grid-column: 1 / -1; min-height: 124px; height: auto; align-items: center; border-radius: 14px; box-shadow: none;}
#predictionsView .promo-grid .promo-copy {max-width: 100%; width: 100%; padding: 18px 22px;}
#predictionsView .promo-grid .has-plan-avatar .promo-copy {max-width: 100%; padding-right: 108px;}
#predictionsView .promo-grid .promo-copy .promo-eyebrow {font-size: 10px; margin-bottom: 5px; letter-spacing: .12em;}
#predictionsView .promo-grid .promo-copy strong {font-size: 19px; line-height: 1.3;}
#predictionsView .promo-grid .promo-copy p {font-size: 12px; line-height: 1.5; margin: 5px 0 0; color: #b9c5d7;}
#predictionsView .promo-grid .promo-cta {display: inline-flex; align-items: center; min-height: 32px; font-size: 11px; padding: 5px 12px; margin: 10px 0 0;}
#predictionsView .promo-banner>.promo-plan-avatar {width: 64px; height: 64px; right: 22px;}
#predictionsView .promo-banner.creative-full {min-height: 140px;}
.sponsored-label {font-size: 10px; padding: 3px 6px; z-index: 3;}
.route-panel {margin: 0;}
.route-card, .route-card-clean {min-width: 0; padding: 20px; border: 1px solid #243449; border-radius: 16px; background: #0a121e;}
.route-card h2 {font-size: 23px;}
.route-card h3 {font-size: 17px;}
.route-card p, .static-copy {font-size: 14px; color: #b1bed0; line-height: 1.7;}
.selection-details {margin: 0 0 18px; border: 1px solid #2b3a51; border-radius: 10px; padding: 0 14px; background: #0e1928;}
.selection-details summary {padding: 12px 0; min-height: 46px; cursor: pointer; color: #b7a1ed; font-size: 13px;}
.selection-details .route-rules {margin: 0 0 14px; padding: 0; background: none; border: 0; font-size: 13px; line-height: 1.7;}
.route-rules span {font-size: 13px; color: #aebbd0;}
.results-filter-bar, .toolbar {grid-template-columns: repeat(2,minmax(0,1fr)); padding: 14px; gap: 12px;}
.results-filter-bar select, .toolbar select, .toolbar input {width: 100%; height: 46px; font-size: 16px;}
.results-filter-bar label {font-size: 11px; color: #b1bed0;}
.metric-cards, .results-filter-bar + .metric-cards {grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px;}
.metric-card {padding: 16px; overflow-wrap: anywhere;}
.metric-card small, .metric-card span {font-size: 12px; color: #a4b3c7;}
.metric-card strong {font-size: 24px;}
.admin-table-wrap {max-width: 100%; overflow-x: auto;}
.admin-analytics-table {font-size: 13px;}
.admin-analytics-table th {font-size: 11px; color: #a4b3c7; padding: 12px;}
.admin-analytics-table td {font-size: 13px; padding: 14px 12px;}
.admin-analytics-table td small {font-size: 12px; color: #a4b3c7;}
.results-limit-note {font-size: 12px; line-height: 1.6; color: #a4b3c7;}
.account-membership-page {max-width: 1200px;}
.account-plan-grid {grid-template-columns: repeat(auto-fit,minmax(min(100%,240px),1fr)); gap: 16px;}
.account-plan-grid>.membership-card:nth-child(n) {grid-column: auto; padding: 22px; min-height: 0;}
.account-plan-grid .membership-card-copy p {font-size: 14px !important; min-height: 0; line-height: 1.65;}
.account-plan-grid .membership-cta, .account-plan-grid .membership-current {font-size: 14px; min-height: 46px; white-space: normal;}
.membership-card-copy h3 {font-size: 21px;}
.account-membership-heading h2 {font-size: 22px; margin-bottom: 18px;}
.membership-badge {font-size: 10px !important;}
.auth-dialog, .match-dialog, .upgrade-dialog {max-width: calc(100vw - 24px); max-height: calc(100dvh - 32px); padding: 28px; overflow-y: auto; overscroll-behavior: contain;}
.auth-dialog {width: 460px;}
.auth-intro p, .auth-dialog form>label, .auth-dialog #authMessage {font-size: 14px;}
.auth-field input {font-size: 16px; min-width: 0;}
.auth-links button {min-height: 44px; font-size: 13px;}
.auth-footnote {font-size: 12px;}
.dialog-close {width: 44px; height: 44px; top: 8px; right: 8px; display: grid; place-items: center;}
.dialog-eyebrow {padding-right: 30px; font-size: 12px;}
.match-dialog h2 {padding-right: 16px; font-size: 24px; overflow-wrap: anywhere;}
.dialog-pick {flex-wrap: wrap; gap: 16px;}
.dialog-signal {grid-template-columns: minmax(0,1fr) minmax(0,1fr); font-size: 13px; gap: 8px;}
.dialog-signal small {grid-column: 1 / -1; font-size: 12px;}
.dialog-meta {font-size: 12px;}
.upgrade-dialog-plan {gap: 16px;}
#upgradeDialogContent {padding: 12px 0 0;}
.upgrade-dialog-plan h2 {font-size: 22px; padding-right: 24px;}
.upgrade-dialog-plan p {font-size: 14px;}
.upgrade-dialog-cta {min-height: 46px;}
.btn {min-height: 44px; font-size: 13px;}
.admin-console {min-width: 0;}
.admin-tabs {overflow-x: auto; max-width: 100%;}
.admin-tabs button {min-height: 44px; flex: 0 0 auto; font-size: 13px;}
.admin-editor-grid, .admin-accounts-grid {grid-template-columns: minmax(0,1fr);}
.admin-toolbar {align-items: center; gap: 10px;}
.admin-toolbar input, .admin-toolbar select, .admin-field-grid input, .admin-field-grid select {min-height: 44px; font-size: 16px;}
.admin-inspector {position: static; min-width: 0;}
.admin-canvas {max-width: 100%; overflow-x: auto;}
.admin-canvas-header, .admin-canvas-body {min-width: 700px;}
.site-footer {margin-top: 28px; padding: 22px 0; gap: 18px; font-size: 12px;}
.footer-main-row, .footer-bottom-row {display: flex; flex-wrap: wrap; align-items: center; gap: 16px;}
.footer-learn-nav {display: flex; flex-wrap: wrap; gap: 4px 16px;}
.site-footer a {display: inline-flex; align-items: center; min-height: 36px; font-size: 12px; color: #a4b3c7;}
.site-footer p {font-size: 12px; color: #95a6bd; line-height: 1.65;}
.footer-model-state {max-width: 100%; overflow-wrap: anywhere;}
.footer-model-state strong, .footer-model-state small {font-size: 11px;}
.footer-right-stack {min-width: 0; max-width: 100%;}
.footer-languages {display: flex; flex-wrap: wrap; gap: 6px; max-width: 100%;}
.footer-languages a {min-width: 36px; min-height: 36px; font-size: 11px; justify-content: center;}
@media (min-width: 640px) {
  :root {--cards-per-panel: 2;}
  .dashboard-main {padding-left: 24px; padding-right: 24px;}
  .dashboard-account-actions .top-upgrade {display: inline-flex; align-items: center;}
  .route-context-meta #pageEyebrow {font-size: 11px;}
  .results-filter-bar {grid-template-columns: repeat(4,minmax(0,1fr));}
}
@media (min-width: 1024px) {
  .dashboard-shell {padding-left: var(--sidebar-width);}
  .dashboard-sidebar {width: var(--sidebar-width); transform: none; visibility: visible; padding: 26px 14px; z-index: 25;}
  .mobile-menu-button, .mobile-menu-close, .mobile-tabs {display: none;}
  .dashboard-main {padding-bottom: 32px;}
  .dashboard-topbar, .dashboard-topbar.overview-mode {min-height: 92px;}
  .profile-button-large .profile-copy {display: grid; max-width: 140px;}
  .profile-name-row strong {font-size: 13px;}
  .profile-membership-row {gap: 5px;}
  .profile-tier {font-size: 10px;}
  .profile-status {display: none;}
  .dashboard-section-toggles {grid-template-columns: repeat(3,minmax(0,1fr));}
}
@media (min-width: 1200px) {
  :root {--cards-per-panel: 1;}
  #predictionsView {grid-template-columns: repeat(2,minmax(0,1fr)); gap: 20px;}
  .metric-cards, .results-filter-bar + .metric-cards {grid-template-columns: repeat(auto-fit,minmax(140px,1fr));}
  #predictionsView .promo-grid .promo-copy {padding: 20px 26px;}
  #predictionsView .promo-grid .promo-copy p {max-width: 70%;}
}
@media (min-width: 1560px) {
  :root {--cards-per-panel: 2; --sidebar-width: 224px;}
  .dashboard-main {padding-left: 32px; padding-right: 32px;}
  #predictionsView>.picks-panel {padding: 20px;}
  .admin-editor-grid {grid-template-columns: minmax(0,1fr) 340px;}
}
@media (max-width: 639px) {
  #bannerTop {order: 25 !important;}
  #bannerMid {order: 45 !important;}
  .dashboard-main {padding-left: max(12px,env(safe-area-inset-left)); padding-right: max(12px,env(safe-area-inset-right));}
  #predictionsView>.picks-panel {padding: 12px;}
  .dashboard-topbar, .dashboard-topbar.overview-mode {gap: 9px; min-height: 72px; padding-top: max(10px,env(safe-area-inset-top));}
  #pageEyebrow {display: none;}
  .sync-bar {padding-bottom: 10px;}
  .sync-state {font-size: 11px;}
  .route-card, .route-card-clean {padding: 14px;}
  .picks-table-wrap, .results-table-wrap {overflow: visible; border: 0;}
  .picks-table, .results-table {display: block; min-width: 0 !important; width: 100%;}
  .picks-table thead, .results-table thead {position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%);}
  .picks-table tbody, .results-table tbody {display: grid; gap: 14px;}
  .picks-table tbody tr, .results-table tbody tr {display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 0 12px; padding: 4px 14px; border: 1px solid #2a3a50; border-radius: 12px; background: #0d1927;}
  .picks-table tbody td, .results-table tbody td {display: block; padding: 12px 0; border: 0; border-bottom: 1px solid #233448; white-space: normal; overflow-wrap: anywhere; min-width: 0; font-size: 14px;}
  .picks-table tbody td:is([data-label="Match"],[data-label="Tournament"]), .results-table tbody td[data-label="Match"] {grid-column: 1 / -1;}
  .picks-table td::before, .results-table td::before {content: attr(data-label); display: block; margin-bottom: 5px; font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: #9eafc4;}
  .picks-table td small, .results-table td small {white-space: normal; font-size: 12px;}
  .admin-field-grid, .admin-dashboard-global, .admin-dashboard-row, .watermark-controls, .admin-plan-grid {grid-template-columns: minmax(0,1fr);}
  .admin-field-grid .span-2 {grid-column: auto;}
  .auth-dialog, .match-dialog, .upgrade-dialog {padding: 24px 20px;}
  .auth-intro h2 {font-size: 26px;}
  .upgrade-dialog-benefits, .dialog-market-grid {grid-template-columns: minmax(0,1fr);}
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {scroll-behavior: auto !important; animation-duration: .01ms !important; transition-duration: .01ms !important;}
}

/* === BLINQ LIGHT POLISH · 2026-09-10 =======================================
   Deliberately isolated so this visual pass is easy to review or revert.
   Functional rules stay in app.js; this block only improves density, hierarchy
   and responsive presentation. */
:root {
  --polish-panel: rgba(8, 16, 28, .88);
  --polish-panel-soft: rgba(10, 20, 34, .72);
  --polish-line: rgba(79, 102, 132, .28);
  --polish-muted: #8fa0b6;
  --polish-text: #edf3fb;
  --polish-violet: #a98cff;
}
.dashboard-main {max-width: 1760px;}
.dashboard-topbar, .dashboard-topbar.overview-mode {box-shadow: 0 10px 30px rgba(0,0,0,.08);}
.route-card, .route-card-clean, #predictionsView>.picks-panel {border-color: var(--polish-line);}
.route-card-clean {box-shadow: none;}

/* Compact live state. It belongs to data pages only, not account/static pages. */
.sync-bar {
  min-height: 0;
  width: max-content;
  max-width: 100%;
  justify-content: flex-start;
  gap: 5px;
  padding: 8px 0 12px;
}
.sync-state {
  min-height: 28px;
  padding: 5px 9px;
  border: 1px solid rgba(77, 104, 136, .24);
  border-radius: 999px;
  background: rgba(8, 18, 30, .62);
  color: #95a8bf;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .035em;
}
.sync-state::before {width: 5px; height: 5px; flex-basis: 5px; box-shadow: 0 0 10px rgba(107,229,106,.35);}
.sync-refresh {
  width: 30px;
  min-width: 30px;
  min-height: 30px;
  height: 30px;
  padding: 0;
  display: grid;
  place-items: center;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 15px;
}
.sync-refresh:hover {border-color: rgba(169,140,255,.28); background: rgba(92,64,170,.11);}
body[data-current-route="account"] #syncBar,
body[data-current-route="admin"] #syncBar,
body[data-current-route="how_blinq_works"] #syncBar,
body[data-current-route="methodology"] #syncBar,
body[data-current-route="model_data"] #syncBar,
body[data-current-route="faq"] #syncBar,
body[data-current-route="responsible_use"] #syncBar {display:none;}

/* Wide desktop header regains useful information without cluttering mobile. */
@media (min-width: 1280px) {
  .dashboard-datetime {display:flex !important;}
}
@media (min-width: 1450px) {
  .header-feature-strip {display:grid !important; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px;}
  .header-slot, .header-plan-promo {min-height: 56px; border-radius: 10px;}
  .header-feature-strip .header-slot-copy span, .header-feature-strip .header-plan-promo span {display:none;}
}
@media (min-width: 1450px) and (max-width: 1699px) {
  .header-feature-strip > :nth-child(3) {display:none !important;}
  .header-feature-strip {grid-template-columns:repeat(2,minmax(0,1fr));}
}

/* Banner inventory follows Admin presets on desktop. Mobile intentionally shows
   fewer creatives to keep the page fast and breathable. */
#predictionsView .promo-grid {grid-template-columns:repeat(4,minmax(0,1fr)); gap:10px;}
#predictionsView .promo-grid .promo-card {min-height: 118px; height:auto;}
#predictionsView .promo-grid .promo-card.span-2 {grid-column:span 2;}
#predictionsView .promo-grid .promo-card.span-4 {grid-column:1/-1;}
#predictionsView .promo-grid .promo-copy {padding:16px 18px; max-width:72%;}
#predictionsView .promo-grid .has-plan-avatar .promo-copy {padding-right:90px;}
#predictionsView .promo-banner>.promo-plan-avatar {width:56px; height:56px; right:18px;}
@media (max-width: 639px) {
  #predictionsView .promo-grid > :nth-child(n+2) {display:none !important;}
  #predictionsView .promo-grid .promo-card {grid-column:1/-1 !important; min-height:112px;}
  #predictionsView .promo-grid .promo-copy {max-width:100%; padding:15px 16px;}
  #predictionsView .promo-grid .has-plan-avatar .promo-copy {padding-right:82px;}
}
@media (min-width:640px) and (max-width:1199px) {
  #predictionsView .promo-grid {grid-template-columns:repeat(2,minmax(0,1fr));}
  #predictionsView .promo-grid > :nth-child(n+3) {display:none !important;}
  #predictionsView .promo-grid .promo-card.span-2,
  #predictionsView .promo-grid .promo-card.span-4 {grid-column:1/-1;}
}

/* Account: clear identity/access summary first, membership catalogue second. */
body[data-current-route="account"] .route-panel {margin-top: 14px;}
body[data-current-route="account"] .route-card-clean {padding:0; border:0; background:transparent;}
.account-overview {
  display:grid;
  grid-template-columns:minmax(0,1.55fr) minmax(300px,.72fr);
  gap:14px;
  max-width:1180px;
  margin:0 auto 16px;
}
.account-profile-card, .account-access-card {
  min-width:0;
  border:1px solid var(--polish-line);
  border-radius:16px;
  background:linear-gradient(145deg,var(--polish-panel),rgba(6,13,23,.92));
  padding:20px;
  box-shadow: inset 0 1px rgba(255,255,255,.02);
}
.account-profile-head {display:grid; grid-template-columns:auto minmax(0,1fr) auto; align-items:center; gap:14px;}
.account-page-avatar {width:64px; height:64px; flex-basis:64px; font-size:18px;}
.account-profile-head h2, .account-access-card h2 {margin:3px 0 2px; color:var(--polish-text); font-size:20px; letter-spacing:-.025em;}
.account-profile-head p, .account-access-status {margin:0; color:var(--polish-muted); font-size:12px;}
.account-card-kicker {display:block; color:var(--polish-violet); font-size:10px; font-weight:950; letter-spacing:.12em;}
.account-verified {align-self:start; padding:6px 9px; border-radius:999px; border:1px solid rgba(90,120,150,.3); font-size:10px; font-weight:900; white-space:nowrap;}
.account-verified.is-verified {color:#8be27c; border-color:rgba(88,190,84,.3); background:rgba(66,147,63,.08);}
.account-verified.needs-verification {color:#f0c76a; border-color:rgba(201,157,61,.3); background:rgba(180,129,31,.08);}
.account-profile-form {display:grid; grid-template-columns:minmax(0,1fr) minmax(150px,.42fr); gap:12px; margin-top:18px; padding-top:16px; border-top:1px solid rgba(61,83,109,.22);}
.account-profile-form label {display:grid; gap:6px; color:#8f9fb3; font-size:11px; font-weight:800;}
.account-profile-form input, .account-profile-form select {height:42px; border:1px solid #26384d; border-radius:9px; background:#07111d; color:#eaf0f7; padding:0 11px; outline:none;}
.account-profile-form input:focus, .account-profile-form select:focus {border-color:#7158ca; box-shadow:0 0 0 3px rgba(113,88,202,.09);}
.account-profile-actions {grid-column:1/-1; display:flex; gap:8px; flex-wrap:wrap;}
.account-profile-form .form-message {grid-column:1/-1; min-height:18px; margin:0; color:#a99ae1; font-size:11px;}
.account-access-card {display:flex; flex-direction:column;}
.account-access-top {display:flex; align-items:start; justify-content:space-between; gap:12px;}
.account-access-top .plan-card-avatar {width:50px; height:50px; flex:0 0 50px;}
.account-access-status {margin-top:2px;}
.account-facts {display:grid; gap:0; margin:16px 0; border-top:1px solid rgba(61,83,109,.22);}
.account-facts>span {display:flex; justify-content:space-between; gap:12px; padding:10px 0; border-bottom:1px solid rgba(61,83,109,.18);}
.account-facts small {color:#70839a; font-size:10px; text-transform:uppercase; letter-spacing:.08em;}
.account-facts strong {color:#d8e1ec; font-size:11px; text-align:right;}
.account-signout {margin-top:auto; width:100%;}
.account-membership-page {max-width:1180px; margin:0 auto; padding:18px 0 4px; border-top:1px solid rgba(53,75,101,.22);}
.account-membership-heading {align-items:flex-end; margin:0 0 14px;}
.account-membership-heading h2 {font-size:21px; margin:2px 0 0;}
.account-membership-heading>p {max-width:540px; margin:0; color:#71839a; font-size:11px; line-height:1.55; text-align:right;}
.account-plan-grid {display:flex; flex-wrap:wrap; justify-content:center; gap:12px;}
.account-plan-grid>.membership-card {flex:0 1 calc(33.333% - 8px); min-width:250px; max-width:380px; min-height:214px; padding:16px!important; border-radius:13px; background:linear-gradient(155deg,rgba(10,20,34,.92),rgba(7,14,24,.96));}
.account-plan-grid .membership-card-copy p {min-height:44px; font-size:11px!important;}
.account-plan-grid .membership-current, .account-plan-grid .membership-cta {min-height:36px;}
.membership-unavailable {align-self:end; display:grid; place-items:center; min-height:36px; padding:7px 9px; border:1px solid rgba(67,88,112,.26); border-radius:8px; color:#708197!important; background:rgba(12,24,38,.45); font-size:9px!important; font-weight:900; letter-spacing:.08em; text-align:center;}
.membership-badge {font-size:9px!important; letter-spacing:.08em;}
@media (max-width: 900px) {
  .account-overview {grid-template-columns:1fr;}
  .account-profile-form {grid-template-columns:1fr;}
  .account-profile-form .account-profile-actions, .account-profile-form .form-message {grid-column:auto;}
  .account-plan-grid>.membership-card {flex-basis:calc(50% - 6px); max-width:none;}
  .account-membership-heading {display:grid; gap:7px;}
  .account-membership-heading>p {text-align:left; max-width:none;}
}
@media (max-width: 560px) {
  .account-profile-card, .account-access-card {padding:16px; border-radius:14px;}
  .account-profile-head {grid-template-columns:auto 1fr;}
  .account-verified {grid-column:1/-1; justify-self:start;}
  .account-plan-grid>.membership-card {flex-basis:100%; min-width:0;}
}

/* Auth polish. */
.auth-field {padding-right:7px;}
.auth-password-toggle {flex:0 0 auto; min-width:52px; height:36px; border:0; border-radius:7px; background:rgba(81,61,151,.13); color:#a995e7; font-size:11px; font-weight:850; cursor:pointer;}
.auth-password-toggle:hover {background:rgba(94,70,177,.22); color:#cab7ff;}
.auth-links {flex-wrap:wrap;}
#resendVerification {width:100%; padding:8px 0; border-top:1px solid rgba(50,69,92,.28);}

/* BTTS placeholder is explicit rather than silently routing back to Dashboard. */
.btts-beta-page {max-width:760px; padding:20px 2px;}
.btts-beta-badge {display:inline-flex; padding:5px 8px; border:1px solid rgba(89,116,197,.3); border-radius:999px; color:#8ea8ff; font-size:10px; font-weight:900; letter-spacing:.1em;}
.btts-beta-page h2 {margin:14px 0 6px; font-size:26px;}
.btts-beta-page>p {max-width:650px; color:#8fa0b6; line-height:1.65;}
.btts-beta-state {display:flex; align-items:center; gap:10px; margin-top:18px; padding:13px 14px; border:1px solid rgba(65,89,117,.28); border-radius:11px; background:rgba(9,20,34,.65); width:max-content; max-width:100%;}
.btts-beta-state i {width:8px; height:8px; border-radius:50%; background:#718199;}
.btts-beta-state span {display:grid; gap:2px;}
.btts-beta-state strong {font-size:12px;}
.btts-beta-state small {color:#71839a; font-size:11px;}

/* Footer: quieter and denser. */
.site-footer {margin-top:22px; padding:14px 0 8px;}
.footer-bottom-row {gap:18px;}
.footer-languages a.active {border-color:#6a54bf; color:#c5b5f3; background:rgba(84,60,156,.12);}
.footer-model-state small {max-width:210px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}

/* Mobile membership compaction: keep the Account route premium without turning it into a long catalog. */
@media (max-width: 560px) {
  .account-membership-page {padding-top:16px;}
  .account-plan-grid {gap:9px;}
  .account-plan-grid>.membership-card {
    grid-template-columns:52px minmax(0,1fr);
    grid-template-rows:auto auto;
    column-gap:12px;
    row-gap:8px;
    min-height:0;
    padding:13px!important;
  }
  .account-plan-grid .plan-card-avatar {grid-column:1;grid-row:1;width:48px;height:48px;}
  .account-plan-grid .membership-card-copy {grid-column:2;grid-row:1;align-self:center;gap:3px;min-width:0;}
  .account-plan-grid .membership-card-copy small {font-size:10px!important;}
  .account-plan-grid .membership-card-copy strong {font-size:12px!important;}
  .account-plan-grid .membership-card-copy p {
    min-height:0;
    margin-top:2px!important;
    font-size:10.5px!important;
    line-height:1.45!important;
    display:-webkit-box;
    -webkit-line-clamp:2;
    -webkit-box-orient:vertical;
    overflow:hidden;
  }
  .account-plan-grid .membership-current,
  .account-plan-grid .membership-cta,
  .account-plan-grid .membership-unavailable {
    grid-column:1/-1;
    grid-row:2;
    min-height:34px;
    margin-top:1px;
    font-size:10px!important;
  }
  .account-plan-grid .membership-badge {top:10px;right:10px;font-size:8px!important;}
  .account-plan-grid>.restricted-plan .membership-card-copy {padding-right:52px;}
}


/* BlinQ 6.5.8 — top-navigation / fixed-zone flexible-banner visual layer.
   Loaded last on purpose: this is the current layout source of truth while
   older CSS remains in the repository for rollback compatibility. */

:root{
  --v658-max:1500px;
  --v658-bg:#040914;
  --v658-panel:#091522;
  --v658-panel-2:#07111d;
  --v658-line:#1c3248;
  --v658-line-soft:#13263a;
  --v658-text:#eef4fb;
  --v658-muted:#899bb2;
  --v658-purple:#8b5cf6;
  --v658-purple-2:#6d38e8;
  --v658-green:#43f77f;
  --v658-cyan:#29b7ff;
  --v658-gold:#f2c24c;
  --v658-radius:13px;
  --v658-gap:12px;
}

html{background:#03070e;scroll-behavior:smooth}
body{margin:0;background:
  radial-gradient(circle at 75% 15%,rgba(18,74,126,.10),transparent 30%),
  radial-gradient(circle at 12% 58%,rgba(41,86,142,.06),transparent 27%),
  #03070e;color:var(--v658-text)}

/* --- shell / global structure ------------------------------------------------ */
.legacy-nav-hook,.dashboard-sidebar{display:none!important}
.app-shell.dashboard-shell.app-shell-topnav{display:block!important;min-height:100dvh;background:transparent!important;padding-left:0!important}
.dashboard-main{
  width:min(var(--v658-max),calc(100vw - 24px))!important;
  max-width:var(--v658-max)!important;
  margin:0 auto!important;
  padding:0 0 30px!important;
  overflow:visible!important;
}

.dashboard-topbar,.dashboard-topbar.overview-mode{
  position:sticky!important;top:0!important;z-index:50!important;
  display:block!important;height:auto!important;min-height:0!important;
  padding:10px 0 8px!important;margin:0!important;
  border:0!important;background:rgba(3,8,17,.93)!important;
  backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);
  box-shadow:0 1px 0 rgba(69,101,135,.28),0 16px 36px rgba(0,0,0,.10)!important;
}
.header-primary{
  min-height:70px;display:grid!important;
  grid-template-columns:140px minmax(0,1fr) max-content!important;
  align-items:center;gap:14px;
}
.top-brand{display:flex!important;flex-direction:column;align-items:flex-start;justify-content:center;gap:2px;min-width:0;text-decoration:none;padding:4px 2px}
.top-brand-logo{display:block;width:108px!important;height:auto!important;max-height:45px;object-fit:contain;object-position:left center}
.top-brand-copy{display:flex!important;flex-direction:column;line-height:1.06;white-space:nowrap;color:#9d74f4}
.top-brand-copy strong{font-size:7px;letter-spacing:.12em;font-weight:900}
.top-brand-copy small{font-size:7px;color:#d4dbe5;margin-top:2px;font-weight:700}

.dashboard-account-actions{display:flex!important;align-items:center;justify-content:flex-end;gap:9px;margin:0!important;min-width:max-content}
.top-upgrade{min-height:42px!important;padding:0 15px!important;border-radius:10px!important;border:1px solid #6f43cc!important;background:linear-gradient(145deg,#422095,#291266)!important;box-shadow:0 0 24px rgba(112,60,226,.14)!important;font-weight:850!important}
.profile-shell{display:flex!important;align-items:stretch!important;min-height:42px!important;padding:0!important;border:1px solid #24384d!important;background:#07111d!important;border-radius:10px!important;box-shadow:none!important;position:relative}
.profile-button.profile-button-large{min-height:40px!important;padding:4px 7px!important;border:0!important;background:transparent!important;gap:8px!important}
.profile-button .avatar-large{width:32px!important;height:32px!important;font-size:11px!important}
.profile-copy{gap:1px!important;min-width:84px}.profile-copy strong{font-size:12px!important}.profile-membership-row{font-size:8px!important}.profile-status{display:none!important}
.profile-menu-toggle{width:34px!important;border-left:1px solid #1b2e43!important;border-radius:0 9px 9px 0!important;background:transparent!important}
.profile-menu{top:calc(100% + 7px)!important;right:0!important;z-index:70!important}

/* --- fixed header CTA zone / flexible inner blocks --------------------------- */
.header-feature-strip{
  --header-slot-count:3;
  display:grid!important;grid-template-columns:repeat(var(--header-slot-count),minmax(0,1fr))!important;
  align-items:stretch;gap:10px!important;min-width:0;max-width:none;overflow:visible!important;
}
.header-feature-strip[hidden]{display:none!important}
.header-feature-strip .header-slot{
  position:relative;display:grid!important;grid-template-columns:40px minmax(0,1fr) auto;align-items:center;gap:10px;
  min-width:0!important;height:62px!important;min-height:62px!important;padding:8px 10px!important;
  border:1px solid #224767!important;border-radius:11px!important;background:
  radial-gradient(circle at 88% 45%,rgba(30,123,205,.17),transparent 32%),linear-gradient(145deg,#081b2d,#06111d)!important;
  color:#eaf5ff!important;text-decoration:none;overflow:hidden;box-shadow:none!important;transition:transform .16s ease,border-color .16s ease,background .16s ease;
}
.header-feature-strip .header-slot:hover{transform:translateY(-1px);border-color:#347eb4!important}
.header-feature-strip .header-slot.theme-gold{border-color:#6c5b23!important;background:radial-gradient(circle at 90% 45%,rgba(199,159,35,.15),transparent 34%),linear-gradient(145deg,#171707,#0d1117)!important}
.header-feature-strip .header-slot.theme-green{border-color:#1d6747!important;background:radial-gradient(circle at 90% 45%,rgba(35,179,103,.15),transparent 34%),linear-gradient(145deg,#081d18,#071218)!important}
.header-feature-strip .header-slot.theme-purple,.header-feature-strip .header-slot.theme-violet{border-color:#5f3bb1!important;background:radial-gradient(circle at 90% 45%,rgba(130,75,225,.17),transparent 34%),linear-gradient(145deg,#17112e,#08111c)!important}
.header-slot-icon,.header-slot-image{width:38px;height:38px;display:grid!important;place-items:center;flex:none;border-radius:9px;background:rgba(19,98,153,.18);font-size:25px;color:#2ebcff}
.theme-gold .header-slot-icon{color:#f3c444;background:rgba(157,121,18,.12)}
.theme-green .header-slot-icon{color:#45ec7c;background:rgba(27,139,82,.12)}
.theme-purple .header-slot-icon,.theme-violet .header-slot-icon{color:#b583ff;background:rgba(98,55,172,.14)}
.header-slot-image img{width:100%;height:100%;object-fit:contain}
.header-slot-copy{min-width:0!important;display:block!important;line-height:1.14!important}
.header-feature-strip .header-slot-copy small{display:block!important;margin:0 0 3px!important;color:#e8f4ff!important;font-size:10px!important;font-weight:900!important;letter-spacing:0!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.header-feature-strip .header-slot-copy strong{display:block!important;margin:0!important;color:#fff!important;font-size:12px!important;line-height:1.1!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.header-feature-strip .header-slot-copy span{display:block!important;margin:3px 0 0!important;color:#8297ad!important;font-size:8px!important;line-height:1.15!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.header-slot-cta{display:inline-flex!important;align-items:center;justify-content:center;min-height:27px;padding:0 8px;border-radius:7px;background:#36bfff;color:#04101a;font-size:8px;font-weight:950;white-space:nowrap;z-index:2}
.theme-gold .header-slot-cta{background:#d9bc42;color:#151104}.theme-green .header-slot-cta{background:#53df7f;color:#04120a}.theme-purple .header-slot-cta,.theme-violet .header-slot-cta{background:#9566f5;color:#fff}

/* --- top navigation ---------------------------------------------------------- */
.top-navigation{display:block!important;margin-top:7px;border:1px solid #172f45;border-radius:11px;background:linear-gradient(180deg,rgba(8,18,31,.96),rgba(5,13,23,.96));overflow:hidden}
.top-navigation .nav-items{display:flex!important;align-items:center;gap:4px;padding:4px!important;overflow-x:auto!important;overflow-y:hidden;scrollbar-width:none;white-space:nowrap}
.top-navigation .nav-items::-webkit-scrollbar{display:none}
.top-navigation .nav-link{flex:1 1 0!important;min-width:max-content!important;min-height:38px!important;padding:0 11px!important;border:1px solid transparent!important;border-radius:8px!important;background:transparent!important;display:flex!important;align-items:center!important;justify-content:center!important;gap:7px!important;color:#bdc8d6!important;font-size:10px!important;font-weight:760!important;line-height:1!important;text-decoration:none!important}
.top-navigation .nav-link:hover{background:#0d1a29!important;color:#fff!important}
.top-navigation .nav-link.active{background:linear-gradient(145deg,#3b2185,#24145d)!important;border-color:#7450cb!important;color:#fff!important;box-shadow:none!important}
.top-navigation .nav-link .nav-symbol,.top-navigation .nav-link .nav-icon{font-size:11px!important}
.top-navigation .nav-link .nav-copy small{display:none!important}
.top-navigation .nav-link .nav-copy strong{font-size:10px!important}

.route-heading{margin:16px 0 12px!important;padding:0 2px!important;border:0!important;background:transparent!important}
.route-heading[hidden]{display:none!important}
.route-heading #pageEyebrow{font-size:9px!important;letter-spacing:.14em!important;color:#9d74f4!important;font-weight:900!important}
.route-heading h1{font-size:23px!important;margin:3px 0!important}.route-heading #pageSubtitle{font-size:11px!important;color:#7f91a8!important}

/* --- dashboard fixed frame --------------------------------------------------- */
#predictionsView{
  display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:var(--v658-gap)!important;align-items:stretch!important;align-content:start!important;margin-top:16px;
}
#predictionsView[hidden]{display:none!important}
.dashboard-hero,.sync-bar,#bannerTop,#bannerMid,#bannerBottom,.dashboard-section-switcher,.dashboard-disabled-sections{grid-column:1/-1!important}

.dashboard-hero{
  min-height:160px;position:relative;overflow:hidden;border:1px solid #20395a;border-radius:13px;padding:20px 35px;
  background:
    radial-gradient(circle at 76% 50%,rgba(77,41,188,.25),transparent 22%),
    radial-gradient(circle at 12% 18%,rgba(25,104,181,.16),transparent 24%),
    linear-gradient(112deg,#07172a 0%,#071324 48%,#191145 100%);
  display:flex!important;align-items:center;color:#fff;isolation:isolate;
}
.dashboard-hero::before{content:"";position:absolute;inset:0;background:
  linear-gradient(116deg,transparent 0 31%,rgba(26,105,180,.18) 31.2% 31.5%,transparent 31.7%),
  radial-gradient(circle at 89% 30%,rgba(255,255,255,.22) 0 1px,transparent 1.5px),
  radial-gradient(circle at 92% 67%,rgba(82,143,235,.28) 0 1px,transparent 1.5px);background-size:auto,27px 27px,31px 31px;opacity:.6;z-index:-1}
.dashboard-hero-copy{position:relative;z-index:3;max-width:440px}
.dashboard-hero-copy small{display:block;margin-bottom:6px;font-size:8px;letter-spacing:.14em;color:#82a7cd;font-weight:850}
.dashboard-hero-copy h2{display:flex;flex-direction:column;margin:0;font-size:28px!important;line-height:.99!important;letter-spacing:-.035em!important}
.dashboard-hero-copy h2 span,.dashboard-hero-copy h2 strong{display:block}.dashboard-hero-copy h2 strong{color:#9b68f8;font-weight:900}
.dashboard-hero-copy p{margin:10px 0 0;color:#a8b5c6;font-size:11px}
.dashboard-hero-ball{position:absolute;right:18%;top:50%;width:110px;height:110px;transform:translateY(-50%) rotate(-18deg);border-radius:50%;background:
  radial-gradient(circle at 35% 28%,#e9fb72 0 6%,#9fce28 28%,#5f8f16 62%,#324c0c 100%);box-shadow:0 0 35px rgba(179,232,63,.18),inset -17px -13px 28px rgba(0,0,0,.28);z-index:1}
.dashboard-hero-ball::before,.dashboard-hero-ball::after{content:"";position:absolute;border:4px solid rgba(235,247,143,.72);border-left-color:transparent;border-right-color:transparent;width:78px;height:104px;border-radius:50%;top:0;left:14px;transform:rotate(44deg)}
.dashboard-hero-ball::after{transform:rotate(-44deg)}
.dashboard-hero-ball i{position:absolute;width:330px;height:3px;left:-260px;top:57px;background:linear-gradient(90deg,transparent,rgba(81,116,255,.34),rgba(217,245,117,.5));transform:rotate(-8deg);filter:blur(.2px)}
.dashboard-hero-ball b{position:absolute;width:170px;height:2px;left:104px;top:47px;background:linear-gradient(90deg,rgba(217,245,117,.4),rgba(111,61,239,.28),transparent);transform:rotate(9deg)}
.dashboard-hero-mark{position:absolute;right:34px;top:50%;transform:translateY(-50%);z-index:3;display:flex;flex-direction:column;align-items:flex-start;line-height:1.05}
.dashboard-hero-mark strong{font-size:24px}.dashboard-hero-mark span{font-size:6px;letter-spacing:.09em}.dashboard-hero-mark small{font-size:6px;color:#abb6c6;margin-top:2px}

.sync-bar{min-height:30px!important;margin:0!important;padding:0 2px!important;border:0!important;background:transparent!important;display:flex!important;align-items:center;gap:8px!important;color:#7890a8!important;font-size:9px!important}
.sync-state{color:#7c8ea1!important;font-size:9px!important}.sync-state::before{content:"";display:inline-block;width:6px;height:6px;margin-right:6px;border-radius:50%;background:#43f77f;box-shadow:0 0 8px rgba(67,247,127,.35)}
.sync-copy{font-size:9px;color:#61768d}.sync-refresh{margin-left:auto!important;border:0!important;background:transparent!important;color:#bb8dff!important;font-size:9px!important;cursor:pointer}

/* --- dashboard sections ------------------------------------------------------ */
#predictionsView>.picks-panel{
  min-width:0!important;min-height:300px!important;height:auto!important;margin:0!important;padding:13px!important;
  border:1px solid #1a3249!important;border-radius:var(--v658-radius)!important;background:linear-gradient(145deg,#091624,#07111c)!important;
  box-shadow:none!important;display:flex!important;flex-direction:column!important;overflow:hidden!important;
}
#predictionsView>.picks-panel[hidden]{display:none!important}
#predictionsView>.picks-panel:hover{border-color:#294762!important;box-shadow:none!important}
.panel-head.picks-head{min-height:28px!important;padding:0 0 9px!important;margin:0 0 8px!important;border-bottom:1px solid #13293d!important;align-items:center!important}
.section-kicker{font-size:12px!important;line-height:1!important;font-weight:900!important;color:#f2f6fb!important}.section-kicker span{font-size:13px!important}
.section-count,.match-count{font-size:9px!important;color:#8b9caf!important}.match-count strong{color:#dce7f3!important}
#predictionsPanel .feed-status,#predictionsPanel #refreshButton{display:none!important}
#predictionToolbar{display:none!important}
.pick-carousel-shell,.market-carousel-shell{display:block!important;position:relative!important;min-height:0!important;flex:1!important}
.pick-carousel,.market-preview-grid{display:grid!important;grid-template-columns:1fr!important;gap:0!important;height:100%!important;min-height:0!important}
.carousel-arrow,.market-arrow,.carousel-dots,.page-position{display:none!important}

.prediction-card,.market-preview-card{
  min-width:0!important;height:auto!important;min-height:205px!important;padding:11px!important;margin:0!important;
  border:1px solid #203b56!important;border-radius:10px!important;background:linear-gradient(155deg,#0a1928,#07121f)!important;box-shadow:none!important;
}
.prediction-card.featured{border-color:#4e3f98!important}
.card-meta{font-size:8px!important;color:#7e93ab!important;gap:6px!important;margin-bottom:8px!important}.card-meta .surface{font-size:7px!important}
.players-row{min-height:67px!important;gap:6px!important}.player-avatar{width:35px!important;height:35px!important;font-size:10px!important}.player-avatar img{width:100%;height:100%;object-fit:cover}.player-name{font-size:9px!important;line-height:1.15!important}.vs{font-size:7px!important}
.pick-row{margin-top:8px!important;padding-top:8px!important;gap:7px!important}.pick-row small{font-size:7px!important}.pick-name{font-size:10px!important}.probability{font-size:19px!important;line-height:1!important}.probability small{font-size:7px!important}.confidence{font-size:6px!important;padding:2px 4px!important}
.market-card-meta{font-size:7.5px!important;line-height:1.35!important;margin-top:7px!important;color:#8295aa!important}
.signal-list{margin-top:7px!important}.signal-row{font-size:8px!important}.analysis-link{margin-top:7px!important;font-size:8px!important;color:#b88cff!important}

.section-see-all-card{
  display:flex!important;align-items:center!important;gap:8px!important;min-height:30px!important;margin:9px -13px -13px!important;padding:8px 13px!important;
  border:0!important;border-top:1px solid #13293d!important;border-radius:0!important;background:transparent!important;text-decoration:none!important;color:#8799ad!important;
}
.section-see-all-card>span{display:none!important}.section-see-all-card strong{font-size:8px!important;font-weight:700!important;color:#6e8399!important}.section-see-all-card b{margin-left:auto!important;color:#bd8dff!important;font-size:8px!important;font-weight:900!important}
.section-see-all-card:hover b{color:#d9bdff!important}

/* --- fixed outer banner zones / equal flexible inner blocks ----------------- */
#predictionsView>.promo-grid{
  --banner-slot-count:1;
  display:grid!important;grid-template-columns:repeat(var(--banner-slot-count),minmax(0,1fr))!important;gap:10px!important;
  width:100%!important;margin:0!important;min-width:0!important;
}
#predictionsView>.promo-grid[hidden]{display:none!important}
#predictionsView>.promo-grid .promo-banner{
  grid-column:auto!important;min-width:0!important;width:100%!important;min-height:116px!important;height:116px!important;
  border-radius:11px!important;border-width:1px!important;box-shadow:none!important;overflow:hidden!important;
}
#predictionsView>.promo-grid .promo-copy{position:relative!important;z-index:3!important;width:100%!important;max-width:78%!important;padding:14px 16px!important}
#predictionsView>.promo-grid .promo-copy strong{font-size:15px!important;line-height:1.12!important}.promo-grid .promo-copy p{font-size:9px!important;line-height:1.35!important;margin-top:4px!important}.promo-grid .promo-eyebrow{font-size:8px!important;margin-bottom:4px!important}.promo-grid .promo-cta{font-size:8px!important;min-height:25px!important;padding:0 9px!important;margin-top:8px!important}
#predictionsView>.promo-grid .promo-image,#predictionsView>.promo-grid .promo-picture{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;z-index:0!important}#predictionsView>.promo-grid .promo-picture img,#predictionsView>.promo-grid .promo-image{width:100%!important;height:100%!important;object-fit:cover!important}
#predictionsView>.promo-grid .promo-art{position:absolute!important;inset:0!important;height:auto!important;z-index:0!important;opacity:.55}

.slot-watermark{position:absolute!important;z-index:4!important;pointer-events:none!important;opacity:var(--wm-opacity,.42)!important;transform:scale(var(--wm-scale,1));transform-origin:center;color:rgba(255,255,255,.36)!important;font-size:10px!important;font-weight:950!important;letter-spacing:.12em!important;text-transform:uppercase!important;white-space:nowrap}
.slot-watermark.wm-top-left{top:7px;left:8px}.slot-watermark.wm-top-right{top:7px;right:8px}.slot-watermark.wm-bottom-left{bottom:7px;left:8px}.slot-watermark.wm-bottom-right{bottom:7px;right:8px}.slot-watermark.wm-center{top:50%;left:50%;transform:translate(-50%,-50%) scale(var(--wm-scale,1))}

/* --- detail pages: deliberately 3–5 compact picks --------------------------- */
.route-panel{margin-top:15px!important}.route-card.route-card-clean{padding:15px!important;border:1px solid #172c41!important;border-radius:13px!important;background:linear-gradient(145deg,#07121f,#050c15)!important;box-shadow:none!important}
.route-rules{margin:0 0 12px!important;padding:10px 12px!important;border:1px solid #1a3046!important;border-radius:9px!important;background:#08131f!important}.route-rules strong{display:block;font-size:10px!important;color:#c39aff!important}.route-rules span{display:block;margin-top:4px;font-size:8px!important;line-height:1.45!important;color:#8598ae!important}
.detail-picks-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.detail-picks-grid .prediction-card,.detail-picks-grid .market-preview-card{min-height:220px!important}.detail-picks-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-top:12px;padding-top:10px;border-top:1px solid #15293d;color:#7f91a7;font-size:9px}

/* --- account retains the accepted 3 + 2 premium composition ---------------- */
.account-page{max-width:1120px!important;margin:0 auto!important}.account-overview{gap:12px!important}.account-card{background:linear-gradient(145deg,#081522,#07101c)!important;border-color:#193149!important;box-shadow:none!important}.account-membership-page{max-width:1120px!important;margin:12px auto 0!important}.telegram-label{display:inline-flex;align-items:center;gap:6px!important}.telegram-label>span{color:#29b7ff;font-size:14px}

/* --- admin visual map for this layout --------------------------------------- */
.admin-canvas-v658{border:1px solid #213a52!important;border-radius:12px!important;background:#050d16!important;padding:10px!important;overflow:auto!important}.admin-canvas-v658 .admin-canvas-header{min-width:720px!important;display:grid!important;grid-template-columns:120px minmax(420px,1fr) 130px!important;gap:8px!important;align-items:stretch!important}.admin-logo-lock,.admin-account-lock,.admin-hero-lock,.admin-topnav-map{border:1px dashed #34506a;border-radius:8px;background:#081521;color:#9eb1c5;padding:9px;font-size:9px;text-align:center}.admin-header-slots{display:grid;gap:6px;grid-template-columns:repeat(1,minmax(0,1fr))}.admin-header-slots.row-count-2{grid-template-columns:repeat(2,minmax(0,1fr))}.admin-header-slots.row-count-3{grid-template-columns:repeat(3,minmax(0,1fr))}.admin-header-slots.row-count-4{grid-template-columns:repeat(4,minmax(0,1fr))}.admin-topnav-map{min-width:720px;margin-top:7px}.admin-topnav-map>div{display:flex;gap:4px;overflow:hidden;margin-top:6px}.admin-canvas-main-full{min-width:720px!important;margin:7px 0 0!important;padding:0!important}.admin-hero-lock{min-height:74px;display:flex;flex-direction:column;align-items:center;justify-content:center}.admin-dashboard-grid-map{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important;gap:7px!important;margin:7px 0!important}.admin-dashboard-grid-map>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.admin-slot-row.fixed-equal{display:grid!important;grid-template-columns:repeat(1,minmax(0,1fr))!important;gap:6px!important}.admin-slot-row.fixed-equal.row-count-2{grid-template-columns:repeat(2,minmax(0,1fr))!important}.admin-slot-row.fixed-equal.row-count-3{grid-template-columns:repeat(3,minmax(0,1fr))!important}.admin-slot-row.fixed-equal.row-count-4{grid-template-columns:repeat(4,minmax(0,1fr))!important}.admin-slot-row.row-off{display:block!important;min-height:34px;border:1px dashed #27394d;border-radius:7px}.admin-row-off-label{display:grid;place-items:center;min-height:34px;color:#697d91;font-size:8px}.admin-zone-controls{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin:10px 0}.admin-row-control{padding:9px;border:1px solid #20364b;border-radius:9px;background:#07131f}.admin-row-control label{display:flex;justify-content:space-between;gap:10px;font-size:9px;font-weight:850}.admin-row-control select{min-width:70px}.admin-row-control small{display:block;margin-top:5px;color:#72869c;font-size:8px;line-height:1.35}

/* --- responsive: fixed outer geometry; internals adapt ---------------------- */
@media(max-width:1240px){
  .header-primary{grid-template-columns:125px minmax(0,1fr) max-content;gap:9px}
  .top-brand-logo{width:96px!important}
  .header-feature-strip{gap:7px!important}
  .header-feature-strip .header-slot{grid-template-columns:32px minmax(0,1fr);height:58px!important;min-height:58px!important;padding:7px 8px!important}
  .header-slot-icon,.header-slot-image{width:30px;height:30px;font-size:19px}.header-slot-cta{display:none!important}
  .header-feature-strip .header-slot-copy span{display:none!important}
  #predictionsView{grid-template-columns:repeat(2,minmax(0,1fr))!important}
  .dashboard-hero-ball{right:16%}.dashboard-hero-mark{right:24px}
  .admin-zone-controls{grid-template-columns:repeat(2,minmax(0,1fr))}
}

@media(max-width:820px){
  :root{--v658-gap:9px}
  body{background:#030810}
  .dashboard-main{width:100%!important;max-width:none!important;padding:0 max(10px,env(safe-area-inset-left)) calc(78px + env(safe-area-inset-bottom)) max(10px,env(safe-area-inset-right))!important}
  .dashboard-topbar,.dashboard-topbar.overview-mode{margin:0 -10px!important;padding:max(7px,env(safe-area-inset-top)) 10px 7px!important;background:rgba(3,8,17,.97)!important}
  .header-primary{grid-template-columns:minmax(96px,1fr) max-content!important;grid-template-areas:"brand actions" "cta cta"!important;gap:7px 8px!important;min-height:0}
  .top-brand{grid-area:brand;flex-direction:row;align-items:center;gap:7px}.top-brand-logo{width:86px!important;max-height:36px}.top-brand-copy{display:none!important}
  .dashboard-account-actions{grid-area:actions;gap:6px!important}.top-upgrade{min-height:36px!important;padding:0 10px!important;font-size:9px!important}.top-upgrade span:first-child{display:none}
  .profile-shell{min-height:36px!important}.profile-button.profile-button-large{min-height:34px!important;padding:2px 5px!important}.profile-button .avatar-large{width:29px!important;height:29px!important}.profile-copy{display:none!important}.profile-menu-toggle{width:29px!important}
  .header-feature-strip{grid-area:cta!important;display:flex!important;gap:8px!important;overflow-x:auto!important;overflow-y:hidden!important;scroll-snap-type:x mandatory;padding:0 0 1px;scrollbar-width:none}
  .header-feature-strip::-webkit-scrollbar{display:none}
  .header-feature-strip .header-slot{flex:0 0 100%!important;width:100%!important;scroll-snap-align:start;height:54px!important;min-height:54px!important;grid-template-columns:34px minmax(0,1fr) auto!important}
  .header-feature-strip .header-slot-copy span{display:block!important}.header-slot-cta{display:inline-flex!important;min-height:24px;font-size:7px!important}
  .top-navigation{margin-top:6px!important;border-radius:9px!important}
  .top-navigation .nav-items{padding:3px!important;gap:2px!important;scroll-snap-type:x proximity}
  .top-navigation .nav-link{flex:0 0 auto!important;min-width:68px!important;height:35px!important;min-height:35px!important;padding:0 8px!important;font-size:8px!important;scroll-snap-align:start}
  .top-navigation .nav-link .nav-copy strong{font-size:8px!important}.top-navigation .nav-link .nav-symbol,.top-navigation .nav-link .nav-icon{font-size:10px!important}
  #predictionsView{grid-template-columns:1fr!important;margin-top:10px!important}
  .dashboard-hero{min-height:112px!important;padding:14px 16px!important;border-radius:11px!important}
  .dashboard-hero-copy{max-width:62%}.dashboard-hero-copy small{display:none}.dashboard-hero-copy h2{font-size:19px!important;line-height:1.02!important}.dashboard-hero-copy p{display:none}.dashboard-hero-ball{right:10%;width:72px;height:72px}.dashboard-hero-ball::before,.dashboard-hero-ball::after{width:51px;height:68px;border-width:3px;left:9px}.dashboard-hero-ball i{width:185px;left:-145px;top:37px}.dashboard-hero-ball b{width:85px;left:67px;top:31px}.dashboard-hero-mark{display:none}
  .sync-bar{min-height:25px!important}.sync-copy{display:none}
  #predictionsView>.picks-panel{min-height:280px!important;padding:11px!important;border-radius:11px!important}
  .section-see-all-card{margin:8px -11px -11px!important;padding:8px 11px!important}
  .prediction-card,.market-preview-card{min-height:190px!important}

  /* one mobile slide at a time even when the fixed zone contains 2–4 blocks */
  #predictionsView>.promo-grid{display:flex!important;overflow-x:auto!important;overflow-y:hidden!important;gap:8px!important;scroll-snap-type:x mandatory!important;scrollbar-width:none}
  #predictionsView>.promo-grid::-webkit-scrollbar{display:none}
  #predictionsView>.promo-grid .promo-banner{flex:0 0 100%!important;width:100%!important;scroll-snap-align:start!important;height:105px!important;min-height:105px!important}
  #predictionsView>.promo-grid .promo-copy{max-width:82%!important;padding:12px 13px!important}
  #predictionsView>.promo-grid .promo-copy strong{font-size:13px!important}

  .route-panel{margin-top:10px!important}.route-card.route-card-clean{padding:11px!important}.detail-picks-grid{grid-template-columns:1fr}.detail-picks-grid .prediction-card,.detail-picks-grid .market-preview-card{min-height:205px!important}.detail-picks-foot{align-items:flex-start;flex-direction:column}
  .route-heading{margin:10px 0 8px!important}.route-heading h1{font-size:19px!important}.route-heading #pageSubtitle{font-size:9px!important}
  .admin-zone-controls{grid-template-columns:1fr}
}

@media(max-width:480px){
  .dashboard-main{padding-left:8px!important;padding-right:8px!important}.dashboard-topbar,.dashboard-topbar.overview-mode{margin-left:-8px!important;margin-right:-8px!important;padding-left:8px!important;padding-right:8px!important}
  .top-upgrade{padding:0 8px!important}.header-feature-strip .header-slot{grid-template-columns:30px minmax(0,1fr) auto!important;padding:6px 7px!important}.header-slot-icon,.header-slot-image{width:28px;height:28px;font-size:17px}.header-feature-strip .header-slot-copy small{font-size:9px!important}.header-feature-strip .header-slot-copy strong{font-size:10px!important}.header-feature-strip .header-slot-copy span{font-size:7px!important}.header-slot-cta{padding:0 6px!important}
  .top-navigation .nav-link{min-width:63px!important;padding:0 6px!important}
  .dashboard-hero{padding:12px 13px!important}.dashboard-hero-copy h2{font-size:18px!important}.dashboard-hero-ball{right:8%;width:66px;height:66px}.dashboard-hero-ball::before,.dashboard-hero-ball::after{width:47px;height:62px;left:8px}
  #predictionsView>.picks-panel{padding:10px!important}.section-see-all-card{margin:8px -10px -10px!important;padding:8px 10px!important}
}

@media(prefers-reduced-motion:reduce){.header-slot,.nav-link{transition:none!important}}


/* BlinQ 6.5.9 — rotating main banner. The outer hero geometry stays fixed;
   1–4 configured creatives rotate inside the same space. */
.dashboard-hero-stage{grid-column:1/-1!important;position:relative;min-height:160px;height:160px;overflow:hidden;border-radius:13px}
.dashboard-hero-stage[hidden]{display:none!important}
.dashboard-hero-stage .dashboard-hero{position:absolute!important;inset:0!important;width:100%!important;height:100%!important;min-height:100%!important;margin:0!important;opacity:0;visibility:hidden;pointer-events:none;transform:translateZ(0) scale(1.006);transition:opacity .35s ease,transform .45s ease,visibility .35s;text-decoration:none!important}
.dashboard-hero-stage .dashboard-hero.is-active{opacity:1;visibility:visible;pointer-events:auto;transform:translateZ(0) scale(1);z-index:2}
.dashboard-hero-stage .hero-slide-picture,.dashboard-hero-stage .hero-slide-image{position:absolute;inset:0;width:100%;height:100%;z-index:-2}
.dashboard-hero-stage .hero-slide-image.fit-cover{object-fit:cover}.dashboard-hero-stage .hero-slide-image.fit-contain{object-fit:contain;background:#050d17}
.dashboard-hero-stage .hero-slide-image.pos-left{object-position:left center}.dashboard-hero-stage .hero-slide-image.pos-right{object-position:right center}.dashboard-hero-stage .hero-slide-image.pos-top{object-position:center top}.dashboard-hero-stage .hero-slide-image.pos-bottom{object-position:center bottom}
.dashboard-hero-stage .hero-slide:has(.hero-slide-image)::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(3,9,17,.90) 0%,rgba(3,9,17,.62) 46%,rgba(3,9,17,.14) 78%,rgba(3,9,17,.08) 100%)}
.dashboard-hero-stage .hero-slide.hero-image-only:has(.hero-slide-image)::after{background:linear-gradient(180deg,rgba(3,9,17,.06),rgba(3,9,17,.15))}
.hero-slide-cta{display:inline-flex;margin-top:12px;min-height:27px;align-items:center;padding:0 10px;border-radius:7px;background:rgba(124,83,242,.18);border:1px solid rgba(154,112,255,.52);color:#d8c8ff;font-size:9px;font-weight:900;letter-spacing:.02em}
.hero-slide.theme-blue .hero-slide-cta{background:rgba(38,161,227,.14);border-color:rgba(48,183,255,.48);color:#75d7ff}.hero-slide.theme-green .hero-slide-cta{background:rgba(42,190,106,.13);border-color:rgba(64,234,132,.42);color:#69f09d}.hero-slide.theme-gold .hero-slide-cta{background:rgba(193,153,39,.13);border-color:rgba(239,193,63,.43);color:#f6d261}
.hero-sponsored{top:12px!important;right:13px!important;left:auto!important;z-index:8!important}
.hero-dots{position:absolute;z-index:10;left:50%;bottom:9px;transform:translateX(-50%);display:flex;align-items:center;gap:6px;padding:4px 7px;border-radius:999px;background:rgba(3,8,16,.42);backdrop-filter:blur(6px)}
.hero-dots button{appearance:none;width:6px;height:6px;padding:0;border:0;border-radius:50%;background:#63748a;opacity:.65;cursor:pointer;transition:width .18s ease,background .18s ease,opacity .18s ease}.hero-dots button.is-active{width:18px;border-radius:999px;background:#9a6df8;opacity:1}
.admin-hero-rotator>span{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:5px;margin:7px 0}.admin-hero-rotator .admin-mini-block{min-height:42px!important;padding:5px!important}.admin-inline-setting{display:flex!important;align-items:center;gap:5px!important;margin-top:7px}.admin-inline-setting input{width:62px!important;min-width:62px!important;padding:5px 6px!important}.hero-row-control{display:grid;gap:5px}
@media(max-width:820px){.dashboard-hero-stage{height:112px;min-height:112px;border-radius:11px}.dashboard-hero-stage .dashboard-hero{min-height:112px!important;padding:14px 16px!important}.hero-slide-cta{margin-top:7px;min-height:23px;padding:0 8px;font-size:7px}.hero-dots{bottom:6px;padding:3px 6px;gap:5px}.hero-dots button{width:5px;height:5px}.hero-dots button.is-active{width:14px}.admin-hero-rotator>span{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(prefers-reduced-motion:reduce){.dashboard-hero-stage .dashboard-hero,.hero-dots button{transition:none!important}}

/* 6.5.9 header grid hardening: old sidebar/header area names must not create
   implicit columns after the top-navigation redesign. */
@media(min-width:821px){
  .header-primary{
    grid-template-columns:140px minmax(0,1fr) max-content!important;
    grid-template-areas:"brand cta actions"!important;
  }
  .top-brand{grid-area:brand!important;justify-self:start!important}
  .header-feature-strip{grid-area:cta!important;width:100%!important;justify-self:stretch!important}
  .dashboard-account-actions{grid-area:actions!important;width:auto!important;max-width:none!important;justify-self:end!important}
}
@media(max-width:820px){
  .top-brand{justify-content:flex-start!important;justify-self:start!important}
}

/* BlinQ 6.5.10 — compact dashboard previews.
   The dashboard only previews one pick per section; See more opens the dedicated
   section page with 3–5 picks. Keeping detail pages separate prevents one rich
   Prime card from stretching the entire three-column dashboard row. */
#predictionsView>.picks-panel{
  min-height:252px!important;
}
#predictionsView .pick-carousel-shell,
#predictionsView .market-carousel-shell{
  flex:0 0 auto!important;
}
#predictionsView .pick-carousel,
#predictionsView .market-preview-grid{
  height:auto!important;
}
#predictionsView .dashboard-preview-card{
  min-height:178px!important;
  height:auto!important;
}
#predictionsView .dashboard-preview-card .signals,
#predictionsView .dashboard-preview-card .analysis-link{
  display:none!important;
}
#predictionsView .dashboard-preview-card .players-row{
  min-height:60px!important;
  margin:7px 0!important;
}
#predictionsView .dashboard-preview-card .data-depth-row{
  margin:-1px 0 5px!important;
  font-size:8px!important;
}
#predictionsView .dashboard-preview-card .betting-row{
  padding:7px 0 0!important;
  margin:0!important;
  gap:5px 10px!important;
  font-size:8px!important;
}
#predictionsView .dashboard-preview-card .market-card-meta{
  min-height:0!important;
  margin-top:6px!important;
  padding-top:0!important;
}
#predictionsView .section-see-all-card{
  margin-top:auto!important;
}
@media(max-width:820px){
  #predictionsView>.picks-panel{min-height:236px!important}
  #predictionsView .dashboard-preview-card{min-height:170px!important}
  #predictionsView .dashboard-preview-card .players-row{min-height:56px!important}
}
@media(max-width:480px){
  #predictionsView>.picks-panel{min-height:228px!important}
  #predictionsView .dashboard-preview-card{min-height:164px!important}
}


/* BlinQ v6.5.13 — symmetric desktop masthead + cleaner upgrade dialog */
@media(min-width:821px){
  .header-primary{--blinq-header-control-h:62px;gap:14px!important;align-items:center!important}
  .header-feature-strip{gap:10px!important;align-items:stretch!important}
  .header-feature-strip .header-slot{height:var(--blinq-header-control-h)!important;min-height:var(--blinq-header-control-h)!important}
  .dashboard-account-actions{gap:10px!important;align-items:stretch!important;height:var(--blinq-header-control-h)!important}
  .top-upgrade,.profile-shell{height:var(--blinq-header-control-h)!important;min-height:var(--blinq-header-control-h)!important;box-sizing:border-box!important}
  .profile-button.profile-button-large{height:60px!important;min-height:60px!important;padding:5px 8px!important}
  .profile-menu-toggle{height:60px!important;min-height:60px!important}
}

.plan-card-avatar em{display:none!important}

.upgrade-dialog{padding:0!important}
#upgradeDialogContent{padding:28px 30px 30px!important}
.upgrade-dialog-eyebrow{font-size:13px!important;line-height:1.3!important}
.upgrade-dialog-plan{gap:16px!important;margin-top:14px!important}
.upgrade-dialog-plan h2{font-size:24px!important;line-height:1.18!important;margin-bottom:7px!important}
.upgrade-dialog-plan p{font-size:14px!important;line-height:1.55!important;color:#95a4b7!important}
.upgrade-dialog-account-facts{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:8px!important;margin:20px 0!important}
.upgrade-dialog-account-facts>span{display:grid!important;gap:4px!important;align-content:center!important;min-height:58px!important;padding:10px 11px!important;text-align:left!important}
.upgrade-dialog-account-facts small{font-size:10px!important;line-height:1.2!important;letter-spacing:.07em!important;text-transform:uppercase!important;color:#72859b!important;font-weight:850!important}
.upgrade-dialog-account-facts strong{font-size:12px!important;line-height:1.3!important;color:#dce6f2!important;font-weight:850!important}
.upgrade-dialog-cta{min-height:46px!important;font-size:13px!important;font-weight:900!important}
@media(max-width:820px){
  .upgrade-dialog{padding:0!important}
  #upgradeDialogContent{padding:24px 20px 22px!important}
  .upgrade-dialog-plan h2{font-size:22px!important}
  .upgrade-dialog-plan p{font-size:14px!important}
  .upgrade-dialog-account-facts{grid-template-columns:1fr!important;gap:7px!important;margin:16px 0!important}
  .upgrade-dialog-account-facts>span{grid-template-columns:92px minmax(0,1fr)!important;align-items:center!important;min-height:45px!important}
  .upgrade-dialog-account-facts small{font-size:10px!important}
  .upgrade-dialog-account-facts strong{font-size:12px!important}
  .upgrade-dialog-cta{font-size:13px!important}
}

/* ========================================================================== */
/* BlinQ v6.5.18 — PRO visual system                                         */
/* Goal: stronger hierarchy, larger readable type, tighter cards, less dead  */
/* space, consistent radii and spacing across dashboard + detail pages.       */
/* ========================================================================== */
:root{
  --pro-max:1560px;
  --pro-gap:16px;
  --pro-radius:14px;
  --pro-card-radius:12px;
  --pro-line:#21364d;
  --pro-line-soft:#182a3c;
  --pro-panel:#081421;
  --pro-panel-2:#0a1827;
  --pro-text:#f3f7fb;
  --pro-muted:#8fa1b5;
  --pro-purple:#8d63ff;
  --pro-green:#55e873;
  --pro-cyan:#49c9ff;
}

html{font-size:16px}
body{font-size:14px!important;line-height:1.45;background:
  radial-gradient(circle at 78% 16%,rgba(24,82,142,.09),transparent 30%),
  radial-gradient(circle at 10% 58%,rgba(75,54,160,.055),transparent 27%),
  #030812!important}
.dashboard-main{width:min(var(--pro-max),calc(100vw - 40px))!important;max-width:var(--pro-max)!important;padding-bottom:34px!important}

/* Masthead */
.dashboard-topbar,.dashboard-topbar.overview-mode{padding:12px 0 10px!important;background:rgba(3,8,17,.95)!important;box-shadow:0 1px 0 rgba(80,110,145,.24),0 12px 30px rgba(0,0,0,.16)!important}
.header-primary{grid-template-columns:128px minmax(0,1fr) max-content!important;gap:16px!important;min-height:68px!important}
.top-brand-logo{width:118px!important;max-height:48px!important}
.top-brand-copy strong{font-size:8px!important;letter-spacing:.16em!important}.top-brand-copy small{font-size:8px!important}
.header-feature-strip{gap:12px!important}
.header-feature-strip .header-slot{height:64px!important;min-height:64px!important;padding:9px 12px!important;border-radius:12px!important;grid-template-columns:42px minmax(0,1fr) auto!important}
.header-slot-icon,.header-slot-image{width:40px!important;height:40px!important;border-radius:10px!important}
.header-feature-strip .header-slot-copy small{font-size:10px!important;letter-spacing:.05em!important;color:#c7d7e8!important}
.header-feature-strip .header-slot-copy strong{font-size:14px!important;line-height:1.12!important;letter-spacing:-.01em!important}
.header-feature-strip .header-slot-copy span{font-size:9px!important;line-height:1.25!important;color:#879bb0!important}
.header-slot-cta{min-height:30px!important;padding:0 10px!important;border-radius:8px!important;font-size:9px!important}
.dashboard-account-actions{gap:12px!important;height:64px!important}
.top-upgrade,.profile-shell{height:64px!important;min-height:64px!important;border-radius:12px!important}
.top-upgrade{padding:0 18px!important;font-size:14px!important}
.profile-button.profile-button-large{height:62px!important;min-height:62px!important;padding:6px 10px!important;gap:10px!important}
.profile-button .avatar-large{width:38px!important;height:38px!important}
.profile-copy{min-width:108px!important}.profile-copy strong{font-size:13px!important}.profile-membership-row{font-size:9px!important}
.profile-menu-toggle{height:62px!important;min-height:62px!important;width:40px!important}

/* Navigation */
.top-navigation{margin-top:9px!important;border-radius:12px!important;border-color:#1c334a!important}
.top-navigation .nav-items{gap:4px!important;padding:5px!important}
.top-navigation .nav-link{min-height:42px!important;padding:0 14px!important;border-radius:9px!important;font-size:12px!important;color:#c5d0dd!important}
.top-navigation .nav-link .nav-copy strong{font-size:12px!important;font-weight:800!important}.top-navigation .nav-link .nav-symbol,.top-navigation .nav-link .nav-icon{font-size:13px!important}
.top-navigation .nav-link.active{background:linear-gradient(145deg,#4a289f,#30176f)!important;border-color:#8257ef!important;box-shadow:0 8px 24px rgba(95,55,205,.16)!important}

/* Main rotating hero */
#predictionsView{gap:var(--pro-gap)!important;margin-top:18px!important}
.dashboard-hero-stage{height:184px!important;min-height:184px!important;border-radius:var(--pro-radius)!important;border:1px solid #264362!important;box-shadow:0 18px 52px rgba(0,0,0,.16)!important}
.dashboard-hero-stage .dashboard-hero{padding:24px 32px!important}
.dashboard-hero-copy{max-width:650px!important}
.dashboard-hero-copy .eyebrow,.hero-slide-eyebrow{font-size:10px!important;letter-spacing:.16em!important}
.dashboard-hero-copy h2,.hero-slide-copy h2{font-size:30px!important;line-height:1.02!important;letter-spacing:-.035em!important;margin:4px 0 8px!important}
.dashboard-hero-copy p,.hero-slide-copy p{font-size:13px!important;line-height:1.45!important;color:#b1c0d0!important}
.hero-slide-cta{min-height:34px!important;padding:0 13px!important;border-radius:8px!important;font-size:10px!important;margin-top:12px!important}
.hero-dots{bottom:10px!important}

/* Status row */
.sync-bar{min-height:32px!important;padding:0 4px!important;font-size:10px!important;gap:10px!important}
.sync-state,.sync-copy,.sync-refresh{font-size:10px!important}.sync-refresh{margin-left:0!important}

/* Dashboard panels: compact outer shell, no dead floor */
#predictionsView>.picks-panel{min-height:0!important;padding:14px!important;border-radius:var(--pro-radius)!important;border-color:var(--pro-line)!important;background:linear-gradient(155deg,rgba(8,20,33,.99),rgba(6,15,25,.99))!important;box-shadow:0 14px 34px rgba(0,0,0,.12)!important}
#predictionsView>.picks-panel:hover{border-color:#2d4b69!important;box-shadow:0 18px 42px rgba(0,0,0,.14)!important}
.panel-head.picks-head{min-height:34px!important;padding:0 0 10px!important;margin:0 0 10px!important;border-bottom-color:#1b3147!important}
.section-kicker{font-size:15px!important;letter-spacing:-.015em!important}.section-kicker span{font-size:16px!important;margin-right:3px!important}
.section-count,.match-count{font-size:10px!important;color:#8ea0b3!important}

#predictionsView .pick-carousel-shell,#predictionsView .market-carousel-shell{flex:0 0 auto!important}
#predictionsView .pick-carousel,#predictionsView .market-preview-grid{height:auto!important}
#predictionsView .dashboard-preview-card,#predictionsView .prediction-card,#predictionsView .market-preview-card{min-height:190px!important;height:auto!important;padding:13px!important;border-radius:var(--pro-card-radius)!important;border-color:#2a4160!important;background:linear-gradient(160deg,#0a1a2a,#081522)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.015)!important}
#predictionsView .prediction-card.featured{border-color:#684ec1!important}
.card-meta{font-size:9px!important;margin-bottom:8px!important;color:#87a0ba!important}.card-meta .surface{font-size:8px!important;padding:3px 6px!important;border-radius:5px!important}.card-meta .time{font-size:10px!important}
.players-row{min-height:74px!important;margin:9px 0 8px!important;grid-template-columns:1fr 28px 1fr!important}.player-avatar{width:42px!important;height:42px!important}.player-name{font-size:11px!important;line-height:1.22!important;margin-top:6px!important;font-weight:800!important}.player-rank{font-size:9px!important;margin-top:2px!important}.vs{font-size:9px!important;color:#7890a8!important}
.pick-row{margin-top:7px!important;padding:9px 0!important;align-items:center!important}.pick-row small{font-size:8px!important;color:#7f92a7!important}.pick-name{font-size:12px!important;line-height:1.2!important}.probability{font-size:23px!important;letter-spacing:-.035em!important}.probability small{font-size:8px!important}.confidence{font-size:7px!important;padding:3px 5px!important;border-radius:5px!important}
.market-card-meta{font-size:8.5px!important;line-height:1.42!important;margin-top:7px!important;color:#8197ad!important;min-height:0!important}
#predictionsView .dashboard-preview-card .betting-row{font-size:9px!important;line-height:1.35!important;padding-top:8px!important}
#predictionsView .dashboard-preview-card .data-depth-row{font-size:9px!important;line-height:1.3!important}

.section-see-all-card{min-height:34px!important;margin:10px -14px -14px!important;padding:9px 14px!important;border-top-color:#1a3045!important}
.section-see-all-card strong{font-size:9px!important}.section-see-all-card b{font-size:9px!important;letter-spacing:.01em!important}

/* Empty cards should be intentionally compact and centered */
#predictionsView .state-card{min-height:132px!important;padding:26px 20px!important;border-radius:10px!important;font-size:13px!important;line-height:1.45!important;color:#b2c0cf!important;border-color:#2a3c50!important;background:rgba(6,15,25,.45)!important}
#predictionsView .state-card small{font-size:10px!important;color:#8293a5!important}

/* Detail views: readable, dense, premium */
.route-heading{margin:20px 0 14px!important}.route-heading #pageEyebrow{font-size:10px!important;letter-spacing:.18em!important}.route-heading h1{font-size:30px!important;line-height:1.05!important;letter-spacing:-.035em!important;margin:5px 0 4px!important}.route-heading #pageSubtitle{font-size:12px!important}
.route-panel{margin-top:16px!important}.route-card.route-card-clean{padding:16px!important;border-radius:var(--pro-radius)!important;border-color:var(--pro-line)!important;background:linear-gradient(155deg,#071522,#050d17)!important;box-shadow:0 16px 44px rgba(0,0,0,.12)!important}
.route-rules{padding:12px 14px!important;margin-bottom:14px!important;border-radius:10px!important}.route-rules strong{font-size:12px!important}.route-rules span{font-size:10px!important}
.detail-picks-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:12px!important}.detail-picks-grid .prediction-card,.detail-picks-grid .market-preview-card{min-height:210px!important;padding:13px!important}
.detail-picks-foot{font-size:10px!important;margin-top:14px!important;padding-top:12px!important}

/* Footer balance */
footer,.site-footer{font-size:11px!important}

@media(max-width:1250px){
  .dashboard-main{width:min(var(--pro-max),calc(100vw - 28px))!important}
  .header-primary{grid-template-columns:112px minmax(0,1fr) max-content!important;gap:11px!important}
  .top-brand-logo{width:104px!important}
  .header-feature-strip{gap:8px!important}.header-feature-strip .header-slot{padding:8px 9px!important;grid-template-columns:36px minmax(0,1fr) auto!important}.header-slot-icon,.header-slot-image{width:34px!important;height:34px!important}.header-feature-strip .header-slot-copy strong{font-size:12px!important}.header-feature-strip .header-slot-copy span{font-size:8px!important}.header-slot-cta{padding:0 8px!important;font-size:8px!important}
  .detail-picks-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
}

@media(max-width:900px){
  .dashboard-main{width:100%!important;padding:0 12px calc(80px + env(safe-area-inset-bottom))!important}
  .dashboard-topbar,.dashboard-topbar.overview-mode{margin:0 -12px!important;padding:8px 12px 7px!important}
  .header-primary{grid-template-columns:minmax(96px,1fr) max-content!important;grid-template-areas:"brand actions" "cta cta"!important;gap:8px!important}
  .top-brand{grid-area:brand!important}.dashboard-account-actions{grid-area:actions!important;height:52px!important}.header-feature-strip{grid-area:cta!important;display:flex!important;overflow-x:auto!important;scroll-snap-type:x mandatory!important;gap:8px!important;scrollbar-width:none}.header-feature-strip::-webkit-scrollbar{display:none}.header-feature-strip .header-slot{flex:0 0 88%!important;height:58px!important;min-height:58px!important;scroll-snap-align:start!important}
  .top-upgrade,.profile-shell{height:52px!important;min-height:52px!important}.profile-button.profile-button-large,.profile-menu-toggle{height:50px!important;min-height:50px!important}.top-upgrade{font-size:12px!important;padding:0 12px!important}.profile-copy{display:none!important}
  .top-navigation .nav-link{min-width:84px!important;min-height:40px!important;padding:0 10px!important}.top-navigation .nav-link .nav-copy strong{font-size:10px!important}
  #predictionsView{grid-template-columns:1fr!important;gap:12px!important;margin-top:12px!important}.dashboard-hero-stage{height:132px!important;min-height:132px!important}.dashboard-hero-stage .dashboard-hero{padding:16px!important}.dashboard-hero-copy h2,.hero-slide-copy h2{font-size:22px!important}.dashboard-hero-copy p,.hero-slide-copy p{font-size:10px!important;max-width:72%!important}.hero-slide-cta{min-height:28px!important;font-size:8px!important}
  #predictionsView>.picks-panel{padding:12px!important}.section-kicker{font-size:14px!important}#predictionsView .dashboard-preview-card,#predictionsView .prediction-card,#predictionsView .market-preview-card{min-height:184px!important;padding:12px!important}.section-see-all-card{margin:9px -12px -12px!important;padding:9px 12px!important}
  .detail-picks-grid{grid-template-columns:1fr!important}.route-heading h1{font-size:24px!important}
}

@media(max-width:480px){
  .dashboard-main{padding-left:9px!important;padding-right:9px!important}.dashboard-topbar,.dashboard-topbar.overview-mode{margin-left:-9px!important;margin-right:-9px!important;padding-left:9px!important;padding-right:9px!important}
  .top-brand-logo{width:92px!important}.header-feature-strip .header-slot{flex-basis:94%!important;grid-template-columns:34px minmax(0,1fr) auto!important}.header-feature-strip .header-slot-copy strong{font-size:11px!important}.header-feature-strip .header-slot-copy small{font-size:8px!important}.header-slot-cta{font-size:7px!important;min-height:27px!important}
  .dashboard-hero-stage{height:120px!important;min-height:120px!important}.dashboard-hero-copy h2,.hero-slide-copy h2{font-size:20px!important}.dashboard-hero-copy p,.hero-slide-copy p{display:none!important}
  .players-row{min-height:68px!important}.player-avatar{width:40px!important;height:40px!important}.player-name{font-size:10px!important}.probability{font-size:21px!important}.pick-name{font-size:11px!important}.market-card-meta{font-size:8px!important}
}

/* ==========================================================================
   BlinQ 6.5.19 — reference-match public dashboard
   Goal: make the live product follow the approved PRO visual, not merely
   scale the legacy dashboard. Functional DOM/JS contracts are unchanged.
   ========================================================================== */
:root{
  --ref-bg:#030913;
  --ref-panel:#071522;
  --ref-card:#091a2a;
  --ref-line:#213d58;
  --ref-line-soft:#173047;
  --ref-text:#f5f8fc;
  --ref-muted:#90a5ba;
  --ref-purple:#8f62ff;
  --ref-green:#63ef78;
  --ref-cyan:#48c9ff;
  --ref-radius:13px;
  --ref-gap:16px;
}
body{background:
  radial-gradient(circle at 76% 10%,rgba(35,92,158,.08),transparent 30%),
  radial-gradient(circle at 12% 50%,rgba(78,55,165,.045),transparent 28%),
  var(--ref-bg)!important;color:var(--ref-text)!important}
.dashboard-main{width:min(1500px,calc(100vw - 64px))!important;max-width:1500px!important;padding-bottom:28px!important}

/* Header: same visual rhythm as the approved mockup. */
.dashboard-topbar,.dashboard-topbar.overview-mode{padding:10px 0 12px!important}
.header-primary{grid-template-columns:136px minmax(0,1fr) max-content!important;gap:14px!important;min-height:72px!important;align-items:center!important}
.top-brand-logo{width:128px!important;max-height:54px!important}
.top-brand-copy strong{font-size:8px!important}.top-brand-copy small{font-size:7.5px!important}
.header-feature-strip{gap:12px!important;align-items:stretch!important}
.header-feature-strip .header-slot{height:66px!important;min-height:66px!important;padding:9px 12px!important;border-radius:12px!important;grid-template-columns:40px minmax(0,1fr) auto!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.025)!important}
.header-slot-icon,.header-slot-image{width:38px!important;height:38px!important;border-radius:10px!important;font-size:19px!important}
.header-feature-strip .header-slot-copy small{font-size:9px!important;letter-spacing:.065em!important;color:#cbd9e7!important;margin-bottom:2px!important}
.header-feature-strip .header-slot-copy strong{font-size:13px!important;line-height:1.12!important;letter-spacing:-.012em!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important}
.header-feature-strip .header-slot-copy span{font-size:9px!important;line-height:1.2!important;color:#8296aa!important;margin-top:2px!important}
.header-slot-cta{min-height:31px!important;padding:0 10px!important;font-size:9px!important;border-radius:8px!important}
.dashboard-account-actions{height:66px!important;gap:10px!important}.top-upgrade,.profile-shell{height:66px!important;min-height:66px!important;border-radius:12px!important}.top-upgrade{padding:0 18px!important;font-size:14px!important}.profile-button.profile-button-large{height:64px!important;min-height:64px!important;padding:7px 11px!important}.profile-button .avatar-large{width:40px!important;height:40px!important}.profile-copy strong{font-size:13px!important}.profile-membership-row{font-size:9px!important}.profile-menu-toggle{height:64px!important;min-height:64px!important}

.top-navigation{margin-top:8px!important;border-radius:12px!important;background:rgba(7,20,33,.9)!important;border-color:#213c56!important}
.top-navigation .nav-items{padding:5px!important;gap:4px!important}
.top-navigation .nav-link{min-height:44px!important;padding:0 14px!important;border-radius:9px!important;color:#cbd5df!important}
.top-navigation .nav-link .nav-copy strong{font-size:12px!important;font-weight:800!important}.top-navigation .nav-link .nav-symbol,.top-navigation .nav-link .nav-icon{font-size:14px!important;opacity:.95!important}
.top-navigation .nav-link.active{background:linear-gradient(145deg,#542db4,#351a7a)!important;border-color:#8c60ff!important;box-shadow:0 8px 26px rgba(95,52,205,.19)!important}

/* Dashboard composition. */
#predictionsView{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:var(--ref-gap)!important;align-items:start!important;align-content:start!important;margin-top:16px!important}
/* The approved visual has no separate technical status strip. Keep it available
   to screen readers but remove the visual clutter from the overview. */
#predictionsView>.sync-bar{position:absolute!important;width:1px!important;height:1px!important;overflow:hidden!important;clip:rect(0 0 0 0)!important;clip-path:inset(50%)!important;white-space:nowrap!important}

/* Hero is deliberately taller: it is the main visual anchor. */
.dashboard-hero-stage{height:212px!important;min-height:212px!important;border-radius:14px!important;border:1px solid #284969!important;box-shadow:0 16px 46px rgba(0,0,0,.18)!important}
.dashboard-hero-stage .dashboard-hero{padding:28px 42px!important}
.dashboard-hero-copy{max-width:680px!important}.dashboard-hero-copy .eyebrow,.hero-slide-eyebrow{font-size:10px!important;letter-spacing:.18em!important}.dashboard-hero-copy h2,.hero-slide-copy h2{font-size:38px!important;line-height:1.00!important;letter-spacing:-.045em!important;margin:5px 0 10px!important}.dashboard-hero-copy p,.hero-slide-copy p{font-size:14px!important;line-height:1.45!important;color:#bac6d3!important;max-width:600px!important}.hero-slide-cta{min-height:38px!important;padding:0 15px!important;border-radius:8px!important;font-size:11px!important;margin-top:13px!important}.hero-dots{bottom:11px!important}

/* Section shells: the shell must hug the content rather than create a large
   empty floor. */
#predictionsView>.picks-panel{min-height:0!important;height:auto!important;align-self:start!important;padding:13px!important;border-radius:var(--ref-radius)!important;border:1px solid var(--ref-line)!important;background:linear-gradient(155deg,#081724,#06111d)!important;box-shadow:0 12px 30px rgba(0,0,0,.11)!important;overflow:hidden!important}
#predictionsView>.picks-panel:hover{border-color:#315472!important;box-shadow:0 16px 34px rgba(0,0,0,.13)!important}
.panel-head.picks-head{min-height:36px!important;padding:0 2px 10px!important;margin:0 0 10px!important;border-bottom:1px solid var(--ref-line-soft)!important}
.section-kicker{font-size:17px!important;line-height:1.05!important;letter-spacing:-.02em!important}.section-kicker span{font-size:18px!important;margin-right:5px!important}.section-count,.match-count{font-size:10px!important;color:#95a8ba!important}
#predictionsPanel .feed-status,#predictionsPanel #refreshButton{display:none!important}

/* Don't let flexbox re-introduce dead vertical space. */
#predictionsView .pick-carousel-shell,#predictionsView .market-carousel-shell{display:block!important;min-height:0!important;flex:0 0 auto!important;height:auto!important}
#predictionsView .pick-carousel,#predictionsView .market-preview-grid{display:grid!important;grid-template-columns:1fr!important;height:auto!important;min-height:0!important;gap:0!important}

/* Live pick card — stronger typography and tighter hierarchy. */
#predictionsView .dashboard-preview-card,#predictionsView .prediction-card,#predictionsView .market-preview-card{min-height:188px!important;height:auto!important;padding:12px 13px!important;border-radius:11px!important;border:1px solid #2b4664!important;background:linear-gradient(160deg,#0a1c2d,#081624)!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.02)!important}
#predictionsView .prediction-card.featured{border-color:#6c50c7!important;box-shadow:inset 0 1px 0 rgba(255,255,255,.02),0 0 0 1px rgba(116,81,213,.05)!important}
.card-meta{min-height:18px!important;font-size:10px!important;line-height:1.15!important;color:#91a8bd!important;margin-bottom:6px!important;gap:7px!important}.card-meta .time{font-size:10px!important;color:#a8bed1!important}.card-meta .surface{font-size:8px!important;padding:3px 6px!important;border-radius:5px!important}
.players-row{min-height:66px!important;margin:7px 0 6px!important;grid-template-columns:1fr 24px 1fr!important;gap:6px!important}.player-avatar{width:45px!important;height:45px!important;font-size:11px!important;border-width:1px!important}.player-name{font-size:12px!important;line-height:1.18!important;margin-top:5px!important;font-weight:800!important;letter-spacing:-.01em!important}.player-rank{font-size:9px!important;margin-top:2px!important;color:#7890a7!important}.vs{font-size:9px!important;color:#7890a7!important}
.pick-row{margin-top:5px!important;padding:8px 0 7px!important;gap:8px!important;border-top:1px solid #203a52!important;border-bottom:1px solid #203a52!important;align-items:center!important}.pick-row small{font-size:9px!important;color:#8298ad!important;margin-bottom:1px!important}.pick-name{font-size:13px!important;line-height:1.18!important;font-weight:800!important}.probability{font-size:25px!important;line-height:.95!important;letter-spacing:-.045em!important}.probability small{font-size:8px!important}.confidence{font-size:7.5px!important;padding:3px 5px!important;border-radius:5px!important}
#predictionsView .dashboard-preview-card .betting-row,#predictionsView .dashboard-preview-card .data-depth-row,.market-card-meta{font-size:9.5px!important;line-height:1.38!important;color:#8ba1b6!important;padding-top:7px!important;margin-top:0!important;min-height:0!important}
#predictionsView .dashboard-preview-card .betting-row{gap:5px 9px!important}.analysis-link{font-size:10px!important}

/* Footer/action belongs visually to the card rather than a distant empty floor. */
.section-see-all-card{min-height:36px!important;margin:10px -13px -13px!important;padding:9px 13px!important;border-top:1px solid var(--ref-line-soft)!important;background:rgba(4,12,21,.25)!important}
.section-see-all-card strong{font-size:9px!important;color:#8296a9!important}.section-see-all-card b{font-size:10px!important;color:#a77bff!important}

/* Empty modules should still align with the design but not consume a huge box. */
#predictionsView .state-card{min-height:188px!important;padding:24px 18px!important;border-radius:11px!important;border-color:#2a435c!important;background:linear-gradient(160deg,rgba(9,25,41,.72),rgba(6,16,27,.74))!important;color:#bdc8d4!important;font-size:13px!important;line-height:1.45!important;display:grid!important;place-items:center!important}
#predictionsView .state-card small{font-size:10px!important;color:#8799ab!important}

/* Give each product a subtle identity like the reference visual. */
#predictionsPanel .section-kicker span,#topDailyPanel .section-kicker span{color:#64ee79!important}
#acePanel .section-kicker span{color:#ff9a48!important}
#valuePanel .section-kicker span{color:#a7ef5b!important}
#doublesPanel .section-kicker span{color:#48c9ff!important}
#sgPanel .section-kicker span{color:#6f83ff!important}

/* Details use the same scale as the dashboard, avoiding the old tiny-card feel. */
.route-heading{margin:22px 0 15px!important}.route-heading #pageEyebrow{font-size:10px!important}.route-heading h1{font-size:32px!important}.route-heading #pageSubtitle{font-size:13px!important}.route-card.route-card-clean{padding:18px!important;border-radius:14px!important}.route-rules{padding:13px 15px!important}.route-rules strong{font-size:12px!important}.route-rules span{font-size:11px!important}.detail-picks-grid{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:14px!important}.detail-picks-grid .prediction-card,.detail-picks-grid .market-preview-card{min-height:200px!important;padding:13px!important}.detail-picks-foot{font-size:10px!important}

@media(max-width:1250px){
  .dashboard-main{width:min(1500px,calc(100vw - 34px))!important}
  .header-primary{grid-template-columns:116px minmax(0,1fr) max-content!important;gap:10px!important}.top-brand-logo{width:108px!important}.header-feature-strip{gap:8px!important}.header-feature-strip .header-slot{padding:8px 9px!important;grid-template-columns:34px minmax(0,1fr) auto!important}.header-slot-icon,.header-slot-image{width:34px!important;height:34px!important}.header-feature-strip .header-slot-copy strong{font-size:11.5px!important}.header-feature-strip .header-slot-copy span{font-size:8px!important}.header-slot-cta{font-size:8px!important;padding:0 8px!important}.top-upgrade{padding:0 13px!important}
  .dashboard-hero-stage{height:196px!important;min-height:196px!important}.dashboard-hero-copy h2,.hero-slide-copy h2{font-size:34px!important}
  .detail-picks-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}
}

@media(max-width:900px){
  .dashboard-main{width:100%!important;padding:0 12px calc(80px + env(safe-area-inset-bottom))!important}
  .header-primary{grid-template-columns:minmax(96px,1fr) max-content!important;grid-template-areas:"brand actions" "cta cta"!important;gap:8px!important;min-height:auto!important}.top-brand{grid-area:brand!important}.dashboard-account-actions{grid-area:actions!important;height:52px!important}.header-feature-strip{grid-area:cta!important;display:flex!important;overflow-x:auto!important;gap:8px!important;scroll-snap-type:x mandatory!important;scrollbar-width:none!important}.header-feature-strip::-webkit-scrollbar{display:none!important}.header-feature-strip .header-slot{flex:0 0 88%!important;height:60px!important;min-height:60px!important;scroll-snap-align:start!important}.top-upgrade,.profile-shell{height:52px!important;min-height:52px!important}.profile-button.profile-button-large,.profile-menu-toggle{height:50px!important;min-height:50px!important}.profile-copy{display:none!important}
  .top-navigation .nav-link{min-width:88px!important;min-height:42px!important;padding:0 10px!important}.top-navigation .nav-link .nav-copy strong{font-size:10.5px!important}
  #predictionsView{grid-template-columns:1fr!important;gap:12px!important;margin-top:12px!important}.dashboard-hero-stage{height:145px!important;min-height:145px!important}.dashboard-hero-stage .dashboard-hero{padding:18px!important}.dashboard-hero-copy h2,.hero-slide-copy h2{font-size:24px!important}.dashboard-hero-copy p,.hero-slide-copy p{font-size:10px!important;max-width:72%!important}.hero-slide-cta{min-height:29px!important;font-size:8px!important;margin-top:8px!important}
  #predictionsView>.picks-panel{padding:12px!important}.section-kicker{font-size:15px!important}.section-kicker span{font-size:16px!important}#predictionsView .dashboard-preview-card,#predictionsView .prediction-card,#predictionsView .market-preview-card,#predictionsView .state-card{min-height:184px!important}.section-see-all-card{margin:9px -12px -12px!important;padding:9px 12px!important}
  .detail-picks-grid{grid-template-columns:1fr!important}.route-heading h1{font-size:25px!important}
}

@media(max-width:480px){
  .dashboard-main{padding-left:9px!important;padding-right:9px!important}.dashboard-topbar,.dashboard-topbar.overview-mode{margin-left:-9px!important;margin-right:-9px!important;padding-left:9px!important;padding-right:9px!important}.top-brand-logo{width:94px!important}.header-feature-strip .header-slot{flex-basis:94%!important}.header-feature-strip .header-slot-copy strong{font-size:11px!important}.header-feature-strip .header-slot-copy small{font-size:8px!important}.header-slot-cta{font-size:7px!important;min-height:27px!important}
  .dashboard-hero-stage{height:132px!important;min-height:132px!important}.dashboard-hero-copy h2,.hero-slide-copy h2{font-size:22px!important}.dashboard-hero-copy p,.hero-slide-copy p{display:none!important}
  .player-avatar{width:42px!important;height:42px!important}.player-name{font-size:11px!important}.probability{font-size:23px!important}.pick-name{font-size:12px!important}.market-card-meta{font-size:9px!important}
}
/* v6.5.19 final micro-adjustment: long CTA titles may wrap instead of truncating. */
@media(min-width:901px){
  .header-feature-strip .header-slot-copy strong{
    white-space:normal!important;overflow:hidden!important;text-overflow:clip!important;
    display:-webkit-box!important;-webkit-box-orient:vertical!important;-webkit-line-clamp:2!important;
    line-clamp:2!important;
  }
}
