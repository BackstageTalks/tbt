<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 420" role="img" aria-label="BlinQ loading">
  <defs>
    <linearGradient id="g1" x1="0" x2="1">
      <stop offset="0%" stop-color="#38d39f" stop-opacity="0"/>
      <stop offset="50%" stop-color="#38d39f" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#38d39f" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="ballGlow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#f8ffc8"/>
      <stop offset="45%" stop-color="#dbff57"/>
      <stop offset="100%" stop-color="#86ff00"/>
    </radialGradient>
    <filter id="softGlow" x="-200%" y="-200%" width="400%" height="400%">
      <feGaussianBlur stdDeviation="6" result="b"/>
      <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <g opacity="0.98">
    <text x="360" y="72" fill="#f4f8fb" font-family="Inter,Segoe UI,Arial,sans-serif" font-size="58" font-weight="800" text-anchor="middle">Blin<tspan fill="#86ff00">Q</tspan></text>
    <text x="360" y="98" fill="#82a0ab" font-family="Inter,Segoe UI,Arial,sans-serif" font-size="14" font-weight="600" text-anchor="middle" letter-spacing="3">TENNIS INTELLIGENCE</text>
  </g>
  <g opacity="0.5">
    <path d="M120 322H600" stroke="url(#g1)" stroke-width="2" stroke-linecap="round"/>
    <path d="M210 298h300" stroke="#1d5d58" stroke-width="1.5" opacity="0.6"/>
    <path d="M252 276h216" stroke="#174842" stroke-width="1" opacity="0.5"/>
    <path d="M360 252v92" stroke="#1a6a60" stroke-width="1.2" opacity="0.65"/>
  </g>
  <g transform="translate(118 155) rotate(-18 74 70)" stroke="#dbe9ef" stroke-width="8" fill="none" opacity="0.95">
    <ellipse cx="74" cy="70" rx="52" ry="64"/>
    <path d="M104 118l34 66" stroke-linecap="round"/>
    <path d="M45 22V118M73 8v124M103 22V118M28 50h92M22 76h104M28 102h92" stroke="#7ea5b1" stroke-width="2.8" opacity="0.7"/>
  </g>
  <g transform="translate(506 156) rotate(18 74 70)" stroke="#dbe9ef" stroke-width="8" fill="none" opacity="0.95">
    <ellipse cx="74" cy="70" rx="52" ry="64"/>
    <path d="M44 118L10 184" stroke-linecap="round"/>
    <path d="M45 22V118M73 8v124M103 22V118M28 50h92M22 76h104M28 102h92" stroke="#7ea5b1" stroke-width="2.8" opacity="0.7"/>
  </g>
  <path d="M188 198 C286 110 435 112 532 196 C449 272 285 272 188 198Z" fill="none" stroke="#3ce2b1" stroke-opacity="0.18" stroke-width="2" stroke-dasharray="8 12"/>
  <g filter="url(#softGlow)">
    <circle r="14" fill="url(#ballGlow)" stroke="#f5ffba" stroke-width="2">
      <animateMotion dur="1.55s" repeatCount="indefinite" rotate="auto" path="M188 198 C286 110 435 112 532 196 C449 272 285 272 188 198Z"/>
    </circle>
  </g>
  <g fill="#9ab3bb" font-family="Inter,Segoe UI,Arial,sans-serif" text-anchor="middle">
    <text x="360" y="360" font-size="16" font-weight="700">Načítavam tenisovú inteligenciu</text>
    <text x="360" y="382" font-size="13" opacity="0.85">model · feed · live radar</text>
  </g>
  <g transform="translate(330 394)">
    <circle cx="0" cy="0" r="4" fill="#86ff00"><animate attributeName="opacity" values="0.25;1;0.25" dur="1s" repeatCount="indefinite"/></circle>
    <circle cx="16" cy="0" r="4" fill="#86ff00"><animate attributeName="opacity" values="0.25;1;0.25" dur="1s" begin="0.18s" repeatCount="indefinite"/></circle>
